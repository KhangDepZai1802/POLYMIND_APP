# Không dùng trực tiếp file này cho production.
# Khuyến nghị trên Oracle VM:
#   bash scripts/init-production-env.sh
# Script sẽ tạo .env.production với secret ngẫu nhiên và quyền file 600.

# === Super admin thật (bắt buộc) ===
# Production không tạo tài khoản mẫu Admin@123.
SUPERADMIN_EMAIL=admin@example.com
SUPERADMIN_PASSWORD=CHANGE_ME_STRONG_ADMIN_PASSWORD
SUPERADMIN_FULLNAME=Super Admin

# === Domain + HTTPS tự động qua Caddy ===
# DOMAIN phải trỏ bản ghi A về public IPv4 của Oracle VM trước khi deploy.
DOMAIN=polymind.example.com
ACME_EMAIL=admin@example.com

# Chỉ dùng khi chạy thêm profile duckdns để cập nhật IP động.
# Oracle VM thường có thể dùng reserved public IP nên để trống.
DUCKDNS_SUBDOMAIN=
DUCKDNS_TOKEN=

# === PostgreSQL ===
POSTGRES_DB=polymind
POSTGRES_USER=polymind
POSTGRES_PASSWORD=CHANGE_ME_STRONG_DB_PASSWORD

# === MinIO ===
MINIO_ROOT_USER=polymind-minio
MINIO_ROOT_PASSWORD=CHANGE_ME_STRONG_MINIO_PASSWORD
MINIO_BUCKET=polymind-documents

# Khóa ký JWT cho REST API, tối thiểu 32 ký tự ngẫu nhiên.
JWT_KEY=CHANGE_ME_RANDOM_AT_LEAST_32_CHARS_JWT_SIGNING_KEY

# === Thông báo email ===
# Giữ false đến khi có SMTP production thật.
SMTP_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USE_SSL=true
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=no-reply@example.com
SMTP_FROM_NAME=POLYMIND
