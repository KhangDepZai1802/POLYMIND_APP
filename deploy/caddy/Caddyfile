# Caddy reverse proxy cho domain thường hoặc DuckDNS — tự xin/gia hạn Let's Encrypt.
# Biến lấy từ service caddy trong docker-compose.production.yml ({$DOMAIN}, {$ACME_EMAIL}).
# Yêu cầu: bản ghi A của DOMAIN trỏ về public IP Oracle VM và ingress 80/443 đã mở.

{
	email {$ACME_EMAIL}
}

{$DOMAIN} {
	encode zstd gzip
	# Blazor Server dùng WebSocket — reverse_proxy của Caddy hỗ trợ sẵn, không cần cấu hình thêm.
	reverse_proxy web:8080 {
		header_up X-Forwarded-Proto {scheme}
	}
}
