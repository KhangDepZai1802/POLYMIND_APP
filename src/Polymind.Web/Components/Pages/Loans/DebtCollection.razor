@page "/debt-collection"
@attribute [Authorize(Policy = "loans:read")]
@inject IDbContextFactory<ApplicationDbContext> DbFactory
@inject NavigationManager Nav
@inject IDialogService DialogService
@inject IAuthorizationService AuthorizationService
@inject AuthenticationStateProvider AuthStateProvider
@inject AgentScope AgentScope
@inject ISnackbar Snackbar

<PageTitle>Thu nợ — POLYMIND</PageTitle>

<PageHeader Eyebrow="TÀI CHÍNH" Title="Thu nợ công ty" Subtitle="@($"{_owing.Count} hồ sơ còn nợ • {_settled.Count} đã tất toán")">
    <Actions>
        <MudButton Class="entity-action-button" Variant="Variant.Outlined" Color="Color.Primary" StartIcon="@Icons.Material.Filled.AccountBalance" Href="/loans">
            Hồ sơ vay
        </MudButton>
    </Actions>
</PageHeader>

@if (_loading)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
}
else
{
    <MudGrid Class="mb-4">
        <MudItem xs="6" md="3">
            <MudPaper Class="pa-3" Elevation="1">
                <MudText Typo="Typo.caption" Class="mud-text-secondary">Hồ sơ còn nợ</MudText>
                <MudText Typo="Typo.h5" Color="Color.Warning"><b>@_owing.Count</b></MudText>
            </MudPaper>
        </MudItem>
        <MudItem xs="6" md="3">
            <MudPaper Class="pa-3" Elevation="1">
                <MudText Typo="Typo.caption" Class="mud-text-secondary">Tổng còn phải thu</MudText>
                <MudText Typo="Typo.h6" Color="Color.Error"><b>@($"{_totalOutstanding:N0} đ")</b></MudText>
            </MudPaper>
        </MudItem>
        <MudItem xs="6" md="3">
            <MudPaper Class="pa-3" Elevation="1">
                <MudText Typo="Typo.caption" Class="mud-text-secondary">Đã thu (các kỳ)</MudText>
                <MudText Typo="Typo.h6" Color="Color.Success"><b>@($"{_totalPaid:N0} đ")</b></MudText>
            </MudPaper>
        </MudItem>
        <MudItem xs="6" md="3">
            <MudPaper Class="pa-3" Elevation="1">
                <MudText Typo="Typo.caption" Class="mud-text-secondary">Đã tất toán</MudText>
                <MudText Typo="Typo.h5" Color="Color.Success"><b>@_settled.Count</b></MudText>
            </MudPaper>
        </MudItem>
    </MudGrid>

    @if (_owing.Count == 0 && _settled.Count == 0)
    {
        <MudAlert Severity="Severity.Info" Dense="true">
            Chưa có hồ sơ <b>nợ công ty</b> nào có lịch trả góp. Trang này chỉ thu nợ với người <b>vay tiền công ty</b>
            (người vay ngân hàng trả cho ngân hàng, không hiện ở đây). Tạo khoản <b>Nợ công ty</b> và bật
            <b>Tạo lịch trả góp</b> ở trang <b>Hỗ trợ vay</b>.
        </MudAlert>
    }
    else
    {
        <MudText Typo="Typo.h6" Class="mb-2">Đang còn nợ</MudText>
        @if (_owing.Count == 0)
        {
            <MudAlert Severity="Severity.Success" Dense="true" Class="mb-4">Không có hồ sơ nào còn nợ.</MudAlert>
        }
        else
        {
            @foreach (var d in _owing)
            {
                @DebtCard(d)
            }
        }

        @if (_settled.Count > 0)
        {
            <MudText Typo="Typo.h6" Class="mb-2 mt-4">Đã tất toán</MudText>
            @foreach (var d in _settled)
            {
                @DebtCard(d)
            }
        }
    }
}

@code {
    private record InstallmentRow(Guid Id, int No, DateOnly DueDate, decimal Amount, decimal PaidAmount, LoanRepaymentStatus Status);
    private record DebtRow(Guid LoanId, Guid CandidateId, string CandidateName, string Code, LoanKind Kind,
        LoanStatus Status, decimal Total, decimal Paid, decimal Outstanding, List<InstallmentRow> Installments);

    private List<DebtRow> _owing = new();
    private List<DebtRow> _settled = new();
    private decimal _totalOutstanding;
    private decimal _totalPaid;
    private bool _loading = true;
    private bool _canCollect;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        _canCollect = (await AuthorizationService.AuthorizeAsync(authState.User, null, "loans:update")).Succeeded
            && (await AuthorizationService.AuthorizeAsync(authState.User, null, "receipts:create")).Succeeded
            && BusinessRoleAccess.CanCollectDebt(authState.User);
        await Load();
    }

    private async Task Load()
    {
        _loading = true;
        await using var db = await DbFactory.CreateDbContextAsync();
        var scope = await AgentScope.GetAsync();

        // CHỈ thu nợ với NỢ CÔNG TY: người vay ngân hàng đã đóng đủ bên trang Tài chính,
        // họ trả góp cho NGÂN HÀNG chứ không nợ công ty → không hiện ở trang Thu nợ.
        var loanQuery = db.Loans.AsNoTracking().Where(l => l.Kind == LoanKind.Company);
        if (scope.IsAgentOnly)
            loanQuery = loanQuery.Where(l => db.Candidates.Any(c => c.Id == l.CandidateId && c.AgentId == scope.AgentId));

        var loans = await loanQuery.ToListAsync();
        var loanIds = loans.Select(l => l.Id).ToList();
        var repayments = await db.LoanRepayments.AsNoTracking()
            .Where(r => loanIds.Contains(r.LoanId))
            .OrderBy(r => r.InstallmentNo)
            .ToListAsync();
        var byLoan = repayments.GroupBy(r => r.LoanId).ToDictionary(g => g.Key, g => g.ToList());

        var candidateIds = loans.Select(l => l.CandidateId).Distinct().ToList();
        var candidates = await db.Candidates.AsNoTracking()
            .Where(c => candidateIds.Contains(c.Id))
            .Select(c => new { c.Id, c.FullName, c.Code })
            .ToDictionaryAsync(c => c.Id);

        var rows = new List<DebtRow>();
        foreach (var l in loans)
        {
            if (!candidates.TryGetValue(l.CandidateId, out var c)) continue;
            var insts = byLoan.TryGetValue(l.Id, out var list) ? list : new List<LoanRepayment>();
            if (insts.Count == 0 && (l.Amount ?? 0m) <= 0m) continue; // không có lịch & không có số nợ → bỏ qua

            var total = insts.Count > 0 ? insts.Sum(r => r.Amount) : (l.Amount ?? 0m);
            var paid = insts.Sum(r => r.PaidAmount);
            var outstanding = Math.Max(0m, total - paid);
            rows.Add(new DebtRow(l.Id, c.Id, c.FullName, c.Code, l.Kind, l.Status, total, paid, outstanding,
                insts.Select(r => new InstallmentRow(r.Id, r.InstallmentNo, r.DueDate, r.Amount, r.PaidAmount, r.Status)).ToList()));
        }

        _owing = rows.Where(r => r.Outstanding > 0m).OrderBy(r => r.CandidateName).ToList();
        _settled = rows.Where(r => r.Outstanding <= 0m && r.Status == LoanStatus.Settled).OrderBy(r => r.CandidateName).ToList();
        _totalOutstanding = _owing.Sum(r => r.Outstanding);
        _totalPaid = rows.Sum(r => r.Paid);
        _loading = false;
    }

    private RenderFragment DebtCard(DebtRow d) =>@<MudPaper Class="pa-3 mb-2" Elevation="1">
        @{
            var paidCount = d.Installments.Count(i => i.Status == LoanRepaymentStatus.Paid);
            var next = d.Installments.Where(i => i.Status != LoanRepaymentStatus.Paid).OrderBy(i => i.No).FirstOrDefault();
            var pct = d.Total > 0 ? (double)(d.Paid / d.Total * 100m) : 0;
            var expanded = _expanded.Contains(d.LoanId);
        }
        <div class="d-flex justify-space-between align-center flex-wrap" style="gap:8px">
            <div style="min-width:0;cursor:pointer" @onclick="@(() => Nav.NavigateTo($"/candidates/{d.CandidateId}"))">
                <MudText Typo="Typo.subtitle2" Style="font-weight:600">@d.CandidateName
                    <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="Labels.ColorOf(d.Kind)" Class="ml-1">@Labels.Vi(d.Kind)</MudChip>
                </MudText>
                <MudText Typo="Typo.caption" Class="mud-text-secondary">@d.Code</MudText>
            </div>
            <div class="text-right">
                <MudText Typo="Typo.body2">Còn nợ: <b style="@(d.Outstanding > 0 ? "color:var(--mud-palette-error)" : "color:var(--mud-palette-success)")">@($"{d.Outstanding:N0} đ")</b></MudText>
                <MudText Typo="Typo.caption" Class="mud-text-secondary">Đã thu @($"{d.Paid:N0}") / @($"{d.Total:N0}") đ</MudText>
            </div>
        </div>

        @if (d.Installments.Count > 0)
        {
            <div class="d-flex align-center mt-2" style="gap:8px">
                <MudProgressLinear Color="Color.Success" Value="@pct" Class="flex-grow-1" Style="height:8px" Rounded="true" />
                <MudText Typo="Typo.caption" Style="white-space:nowrap">@paidCount/@d.Installments.Count kỳ</MudText>
            </div>
            <div class="d-flex align-center justify-space-between flex-wrap mt-1" style="gap:8px">
                <MudText Typo="Typo.caption" Class="mud-text-secondary">
                    @if (next is not null)
                    {
                        <text>Kỳ tới: kỳ @next.No • hạn @next.DueDate.ToString("dd/MM/yyyy") • @($"{next.Amount:N0}") đ</text>
                    }
                    else
                    {
                        <text>Đã thu đủ tất cả các kỳ.</text>
                    }
                </MudText>
                <div class="d-flex" style="gap:6px">
                    @if (_canCollect && next is not null)
                    {
                        <MudButton Size="Size.Small" Variant="Variant.Filled" Color="Color.Success" StartIcon="@Icons.Material.Filled.Check"
                                   OnClick="@(() => MarkPaid(next.Id))">Thu kỳ tới</MudButton>
                    }
                    @if (_canCollect && d.Outstanding > 0m)
                    {
                        <MudButton Size="Size.Small" Variant="Variant.Outlined" Color="Color.Success" StartIcon="@Icons.Material.Filled.Payments"
                                   OnClick="@(() => CollectRemaining(d))">Thu hết phần còn lại</MudButton>
                    }
                    <MudButton Size="Size.Small" Variant="Variant.Text" EndIcon="@(expanded ? Icons.Material.Filled.ExpandLess : Icons.Material.Filled.ExpandMore)"
                               OnClick="@(() => ToggleExpand(d.LoanId))">@(expanded ? "Ẩn lịch" : "Xem lịch")</MudButton>
                </div>
            </div>

            <MudCollapse Expanded="expanded">
                <div class="table-scroll-x mt-2">
                    <MudSimpleTable Dense="true" Hover="true">
                        <thead>
                            <tr><th>Kỳ</th><th>Hạn</th><th style="text-align:right">Phải trả</th><th style="text-align:right">Đã trả</th><th>Trạng thái</th><th style="text-align:right">Thao tác</th></tr>
                        </thead>
                        <tbody>
                            @foreach (var i in d.Installments)
                            {
                                <tr>
                                    <td>@i.No</td>
                                    <td>@i.DueDate.ToString("dd/MM/yyyy")</td>
                                    <td style="text-align:right">@($"{i.Amount:N0}")</td>
                                    <td style="text-align:right">@($"{i.PaidAmount:N0}")</td>
                                    <td><MudChip T="string" Size="Size.Small" Color="Labels.ColorOf(i.Status)">@Labels.Vi(i.Status)</MudChip></td>
                                    <td style="text-align:right">
                                        @if (_canCollect && i.Status != LoanRepaymentStatus.Paid)
                                        {
                                            <MudButton Size="Size.Small" Variant="Variant.Outlined" Color="Color.Success" StartIcon="@Icons.Material.Filled.Check"
                                                       OnClick="@(() => MarkPaid(i.Id))">Đã thu</MudButton>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </MudSimpleTable>
                </div>
            </MudCollapse>
        }
        else
        {
            <div class="d-flex align-center justify-space-between flex-wrap mt-2" style="gap:8px">
                <MudText Typo="Typo.caption" Class="mud-text-secondary">Chưa có lịch trả góp — có thể thu toàn bộ số nợ còn lại.</MudText>
                @if (_canCollect && d.Outstanding > 0m)
                {
                    <MudButton Size="Size.Small" Variant="Variant.Filled" Color="Color.Success" StartIcon="@Icons.Material.Filled.Payments"
                               OnClick="@(() => CollectRemaining(d))">Thu hết phần còn lại</MudButton>
                }
            </div>
        }
    </MudPaper>;

    private readonly HashSet<Guid> _expanded = new();
    private void ToggleExpand(Guid loanId)
    {
        if (!_expanded.Add(loanId)) _expanded.Remove(loanId);
    }

    private async Task MarkPaid(Guid installmentId)
    {
        await CollectAsync(null, installmentId);
    }

    private async Task CollectRemaining(DebtRow debt)
    {
        var confirm = await DialogService.ShowMessageBoxAsync(
            "Thu hết phần còn lại?",
            $"Xác nhận đã thực thu {debt.Outstanding:N0} đ từ {debt.CandidateName}. Hệ thống sẽ sinh phiếu thu và chỉ tất toán khi đã thu đủ 100%.",
            yesText: "Xác nhận đã thu", cancelText: "Hủy");
        if (confirm != true) return;

        await CollectAsync(debt.LoanId, null);
    }

    private async Task CollectAsync(Guid? loanId, Guid? installmentId)
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var authorized = (await AuthorizationService.AuthorizeAsync(authState.User, null, "loans:update")).Succeeded
            && (await AuthorizationService.AuthorizeAsync(authState.User, null, "receipts:create")).Succeeded
            && BusinessRoleAccess.CanCollectDebt(authState.User);
        if (!authorized)
        {
            Snackbar.Add("Chỉ Kế toán hoặc Super Admin được thu nợ và sinh phiếu thu.", Severity.Warning);
            return;
        }

        await using var db = await DbFactory.CreateDbContextAsync();
        await using var transaction = await db.Database.BeginTransactionAsync();
        LoanRepayment? installment = null;
        if (installmentId is Guid iid)
        {
            installment = await db.LoanRepayments.FirstOrDefaultAsync(r => r.Id == iid);
            if (installment is null) { Snackbar.Add("Không tìm thấy kỳ trả nợ.", Severity.Warning); return; }
            loanId = installment.LoanId;
            if (await db.Receipts.AnyAsync(r => r.LoanRepaymentId == iid))
            {
                Snackbar.Add("Kỳ trả nợ này đã có phiếu thu.", Severity.Info);
                await Load();
                return;
            }
        }

        if (loanId is not Guid effectiveLoanId) return;
        var loan = await db.Loans.FirstOrDefaultAsync(l => l.Id == effectiveLoanId);
        if (loan is null) { Snackbar.Add("Không tìm thấy khoản nợ.", Severity.Warning); return; }
        var repayments = await db.LoanRepayments.Where(r => r.LoanId == effectiveLoanId).ToListAsync();
        var today = DateOnly.FromDateTime(DateTime.UtcNow);
        var now = DateTimeOffset.UtcNow;
        var collection = LoanCollectionRules.Collect(loan, repayments, installmentId, today, now);
        if (!collection.Succeeded)
        {
            Snackbar.Add(collection.Error!, Severity.Warning);
            await Load();
            return;
        }

        var actorId = await AuthStateProvider.GetRequiredUserIdAsync(db);
        var receipt = new Receipt
        {
            Code = $"RC-{DateTime.UtcNow:yyyyMMdd}-{Random.Shared.Next(1000, 9999)}",
            ReceiptType = ReceiptType.Income,
            CandidateId = loan.CandidateId,
            LoanId = loan.Id,
            LoanRepaymentId = installmentId,
            Amount = collection.Amount,
            Description = installment is null
                ? $"Thu hết phần còn lại khoản nợ {loan.Code}"
                : $"Thu kỳ {installment.InstallmentNo} khoản nợ {loan.Code}",
            ReceiptDate = today,
            CreatedBy = actorId,
        };
        db.Receipts.Add(receipt);
        db.AddAudit(actorId, "create", "receipts", receipt.Id, null, new
        {
            receipt.Code,
            receipt.Amount,
            receipt.LoanId,
            receipt.LoanRepaymentId,
        });
        db.AddAudit(actorId, "collect_debt", "loans", loan.Id, null, new
        {
            ReceiptId = receipt.Id,
            receipt.Amount,
            InstallmentId = installmentId,
            collection.Settled,
        });
        await db.SaveChangesAsync();
        await transaction.CommitAsync();
        Snackbar.Add($"Đã thu {collection.Amount:N0} đ và tạo phiếu thu {receipt.Code}.", Severity.Success);
        await Load();
    }
}
