@using Microsoft.AspNetCore.Identity
@using Polymind.Domain.Security
@using Polymind.Infrastructure.Identity
@using Polymind.Infrastructure.Persistence.Constants
@inject IDbContextFactory<ApplicationDbContext> DbFactory
@inject UserManager<ApplicationUser> UserManager
@inject AuthenticationStateProvider AuthState
@inject ISnackbar Snackbar
@inject IDialogService DialogService

@* Panel quản lý tài khoản dùng chung cho trang "Tài khoản" (nhân sự nội bộ) và trang "Phụ huynh & Học sinh".
   Chỉ tạo/hiển thị/đổi vai trò trong phạm vi ManagedRoles → 2 nhóm tài khoản không trộn lẫn được.
   Trang Phụ huynh & Học sinh tắt ShowRoleManagement vì vai trò đã cố định theo tài khoản gắn ở hồ sơ ứng viên. *@

@if (_loading)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
}
else
{
    @if (ShowCreateForm)
    {
    <AuthorizeView Policy="users:create">
        <Authorized>
            <MudPaper Class="pa-4 mb-4" Elevation="0" Outlined="true">
                <MudText Typo="Typo.subtitle1" Class="mb-3"><b>Tạo tài khoản</b></MudText>
                <MudGrid>
                    <MudItem xs="12" md="3">
                        <MudTextField @bind-Value="_newEmail" Label="Email" Variant="Variant.Outlined" Margin="Margin.Dense" />
                    </MudItem>
                    <MudItem xs="12" md="3">
                        <MudTextField @bind-Value="_newFullName" Label="Họ tên" Variant="Variant.Outlined" Margin="Margin.Dense" />
                    </MudItem>
                    <MudItem xs="12" md="3">
                        <MudSelect T="string" @bind-Value="_newRole" Label="Vai trò" Variant="Variant.Outlined" Margin="Margin.Dense">
                            @foreach (var role in _assignableRoles)
                            {
                                <MudSelectItem Value="@(role.Name ?? "")">@RoleDisplay(role)</MudSelectItem>
                            }
                        </MudSelect>
                    </MudItem>
                    <MudItem xs="12" md="2">
                        <MudTextField @bind-Value="_newPassword" Label="Mật khẩu" Variant="Variant.Outlined" Margin="Margin.Dense" />
                    </MudItem>
                    <MudItem xs="12" md="1" Class="d-flex align-center">
                        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="CreateUserAsync">Tạo</MudButton>
                    </MudItem>
                </MudGrid>
            </MudPaper>
        </Authorized>
    </AuthorizeView>
    }

    <MudText Typo="Typo.body2" Class="mud-text-secondary mb-3">Mỗi vai trò có một bảng riêng để dễ quản lý tài khoản.</MudText>

    @* RB-3: tìm kiếm theo tên (kèm email) — lọc các bảng tài khoản bên dưới. *@
    <MudTextField @bind-Value="_search" @bind-Value:after="StateHasChanged" Immediate="true"
                  Placeholder="Tìm theo tên hoặc email…" Label="Tìm kiếm theo tên"
                  Variant="Variant.Outlined" Margin="Margin.Dense" Clearable="true"
                  Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search"
                  Class="mb-3" Style="max-width:420px" />

    @foreach (var grp in GroupedUsers())
    {
        <MudPaper Class="pa-3 mb-4" Elevation="0" Outlined="true">
            <div class="d-flex align-center flex-wrap mb-2" style="gap:8px">
                <MudIcon Icon="@grp.Icon" Color="@grp.Color" />
                <MudText Typo="Typo.subtitle1"><b>@grp.Label</b></MudText>
                <MudChip T="string" Size="Size.Small" Color="@grp.Color">@grp.Users.Count tài khoản</MudChip>
            </div>

            @if (grp.Users.Count == 0)
            {
                <MudText Typo="Typo.body2" Class="mud-text-secondary">Chưa có tài khoản nào ở vai trò này.</MudText>
            }
            else
            {
                <MudHidden Breakpoint="Breakpoint.SmAndDown">
                    <div class="table-scroll-x">
                        <MudSimpleTable Dense="true" Hover="true" Striped="true">
                            <thead>
                                <tr>
                                    <th>Email</th>
                                    <th>Họ tên</th>
                                    @if (ShowRoleManagement)
                                    {
                                        <th>Chuyển vai trò</th>
                                    }
                                    <th>Trạng thái</th>
                                    <th style="text-align:right">Thao tác</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var user in grp.Users)
                                {
                                    <tr>
                                        <td>@user.Email</td>
                                        <td>@user.FullName</td>
                                        @if (ShowRoleManagement)
                                        {
                                            <td style="min-width:220px">
                                                @if (IsRoleFixed(user))
                                                {
                                                    <MudTooltip Text="@FixedRoleHint(user)">
                                                        <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="Color.Error" Icon="@Icons.Material.Filled.Lock">Cố định</MudChip>
                                                    </MudTooltip>
                                                }
                                                else
                                                {
                                                    <MudSelect T="string" @bind-Value="user.SelectedRole" Dense="true" Margin="Margin.Dense">
                                                        @foreach (var role in _assignableRoles)
                                                        {
                                                            <MudSelectItem Value="@(role.Name ?? "")">@RoleDisplay(role)</MudSelectItem>
                                                        }
                                                    </MudSelect>
                                                }
                                            </td>
                                        }
                                        <td>
                                            <MudChip T="string" Size="Size.Small" Color="@(user.IsActive ? Color.Success : Color.Error)">
                                                @(user.IsActive ? "Đang hoạt động" : "Đã khóa")
                                            </MudChip>
                                        </td>
                                        <td style="text-align:right;white-space:nowrap">
                                            <AuthorizeView Roles="super_admin">
                                                <Authorized>
                                                    <MudButton Size="Size.Small" Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Edit" OnClick="@(() => OpenEditUserAsync(user))">Sửa</MudButton>
                                                    @if (AllowDelete && !IsSuperAdminRow(user))
                                                    {
                                                        <MudButton Size="Size.Small" Variant="Variant.Outlined" Color="Color.Error" StartIcon="@Icons.Material.Filled.Delete" OnClick="@(() => DeleteUserAsync(user))">Xóa</MudButton>
                                                    }
                                                </Authorized>
                                            </AuthorizeView>
                                            <AuthorizeView Policy="users:update">
                                                <Authorized>
                                                    @if (ShowRoleManagement && !IsRoleFixed(user))
                                                    {
                                                        <MudButton Size="Size.Small" Variant="Variant.Outlined" OnClick="@(() => SaveUserRoleAsync(user))">Lưu role</MudButton>
                                                    }
                                                    <MudButton Size="Size.Small" Variant="Variant.Outlined" OnClick="@(() => ToggleUserAsync(user))">
                                                        @(user.IsActive ? "Khóa" : "Mở")
                                                    </MudButton>
                                                </Authorized>
                                            </AuthorizeView>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </MudSimpleTable>
                    </div>
                </MudHidden>

                <MudHidden Breakpoint="Breakpoint.SmAndDown" Invert="true">
                    @foreach (var user in grp.Users)
                    {
                        <MudPaper Class="mobile-card pa-3" Elevation="0">
                            <div class="d-flex justify-space-between align-center" style="gap:8px">
                                <div style="min-width:0">
                                    <MudText Typo="Typo.subtitle2" Style="font-weight:600">@user.FullName</MudText>
                                    <MudText Typo="Typo.caption" Class="mud-text-secondary">@user.Email</MudText>
                                </div>
                                <MudChip T="string" Size="Size.Small" Color="@(user.IsActive ? Color.Success : Color.Error)">@(user.IsActive ? "Đang hoạt động" : "Đã khóa")</MudChip>
                            </div>
                            @if (ShowRoleManagement && IsRoleFixed(user))
                            {
                                <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="Color.Error" Icon="@Icons.Material.Filled.Lock" Class="mt-2">@FixedRoleHint(user)</MudChip>
                            }
                            else if (ShowRoleManagement)
                            {
                                <MudSelect T="string" @bind-Value="user.SelectedRole" Dense="true" Margin="Margin.Dense" Label="Chuyển vai trò" Class="mt-2">
                                    @foreach (var role in _assignableRoles)
                                    {
                                        <MudSelectItem Value="@(role.Name ?? "")">@RoleDisplay(role)</MudSelectItem>
                                    }
                                </MudSelect>
                            }
                            <div class="d-flex flex-wrap justify-end mt-2" style="gap:4px">
                                <AuthorizeView Roles="super_admin">
                                    <Authorized>
                                        <MudButton Size="Size.Small" Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Edit" OnClick="@(() => OpenEditUserAsync(user))">Sửa</MudButton>
                                        @if (AllowDelete && !IsSuperAdminRow(user))
                                        {
                                            <MudButton Size="Size.Small" Variant="Variant.Outlined" Color="Color.Error" StartIcon="@Icons.Material.Filled.Delete" OnClick="@(() => DeleteUserAsync(user))">Xóa</MudButton>
                                        }
                                    </Authorized>
                                </AuthorizeView>
                                <AuthorizeView Policy="users:update">
                                    <Authorized>
                                        @if (ShowRoleManagement && !IsRoleFixed(user))
                                        {
                                            <MudButton Size="Size.Small" Variant="Variant.Outlined" OnClick="@(() => SaveUserRoleAsync(user))">Lưu role</MudButton>
                                        }
                                        <MudButton Size="Size.Small" Variant="Variant.Outlined" OnClick="@(() => ToggleUserAsync(user))">@(user.IsActive ? "Khóa" : "Mở")</MudButton>
                                    </Authorized>
                                </AuthorizeView>
                            </div>
                        </MudPaper>
                    }
                </MudHidden>
            }
        </MudPaper>
    }
}

@code {
    /// <summary>Các vai trò mà panel này được phép tạo/hiển thị/đổi. Ngoài danh sách này panel không đụng tới.</summary>
    [Parameter, EditorRequired] public IReadOnlyList<string> ManagedRoles { get; set; } = Array.Empty<string>();

    /// <summary>Khi bật: mọi vai trò trong panel là cố định (không đổi role được), chỉ tạo mới/sửa/khóa.</summary>
    [Parameter] public bool RolesFixed { get; set; }

    /// <summary>Các vai trò được phép TẠO mới / CHUYỂN sang (dropdown vai trò). Mặc định = ManagedRoles.
    /// Tài khoản mang vai trò ngoài danh sách này vẫn hiển thị nhưng coi như cố định (VD: Đại lý/CTV chỉ tạo ở trang Đại lý &amp; Hoa hồng).</summary>
    [Parameter] public IReadOnlyList<string>? CreatableRoles { get; set; }

    /// <summary>Khi bật: super admin được XÓA hẳn tài khoản trong panel (luôn có bước xác nhận).</summary>
    [Parameter] public bool AllowDelete { get; set; }

    /// <summary>Hiện card "Tạo tài khoản". Tắt ở trang Phụ huynh &amp; Học sinh (tạo trực tiếp ở chi tiết ứng viên).</summary>
    [Parameter] public bool ShowCreateForm { get; set; } = true;

    /// <summary>Hiện cột/dropdown đổi vai trò và nút lưu role. Tắt khi vai trò tài khoản được cố định bởi luồng nghiệp vụ khác.</summary>
    [Parameter] public bool ShowRoleManagement { get; set; } = true;

    private bool _loading = true;
    private List<UserRow> _users = new();
    private List<ApplicationRole> _assignableRoles = new();
    private string _newEmail = "";
    private string _newFullName = "";
    private string _newPassword = DbSeeder.DefaultAdminPassword;
    private string? _newRole;
    private string _search = "";

    private HashSet<string> ManagedSet => ManagedRoles.ToHashSet();
    // Vai trò được phép tạo mới / gán qua dropdown (mặc định = ManagedRoles).
    private HashSet<string> CreatableSet => (CreatableRoles ?? ManagedRoles).ToHashSet();

    protected override async Task OnInitializedAsync() => await LoadAsync();

    public async Task LoadAsync()
    {
        _loading = true;
        await using var db = await DbFactory.CreateDbContextAsync();
        var creatable = CreatableSet;
        _assignableRoles = await db.Roles
            .Where(r => r.Name != null && creatable.Contains(r.Name))
            .OrderBy(r => r.Name).ToListAsync();
        _newRole ??= _assignableRoles.FirstOrDefault()?.Name;
        await LoadUsersAsync();
        _loading = false;
    }

    private async Task LoadUsersAsync()
    {
        var managed = ManagedSet;
        await using var db = await DbFactory.CreateDbContextAsync();
        var users = await db.Users.OrderBy(u => u.Email).ToListAsync();
        _users.Clear();
        foreach (var user in users)
        {
            var roles = await UserManager.GetRolesAsync(user);
            var primary = roles.FirstOrDefault();
            // Chỉ hiển thị tài khoản thuộc phạm vi vai trò panel này quản lý.
            if (primary is null || !managed.Contains(primary)) continue;
            _users.Add(new UserRow
            {
                Id = user.Id,
                Email = user.Email ?? user.UserName ?? "",
                FullName = user.FullName,
                IsActive = user.IsActive,
                Roles = roles.ToList(),
                PrimaryRole = primary,
                SelectedRole = primary,
            });
        }
    }

    private async Task CreateUserAsync()
    {
        if (string.IsNullOrWhiteSpace(_newEmail) || string.IsNullOrWhiteSpace(_newFullName))
        {
            Snackbar.Add("Vui lòng nhập email và họ tên.", Severity.Warning);
            return;
        }
        // Chốt chặn: chỉ cho tạo tài khoản trong phạm vi vai trò được phép tạo ở trang này
        // (VD: Đại lý/CTV không tạo được ở đây — chỉ tạo ở trang Đại lý & Hoa hồng).
        if (string.IsNullOrWhiteSpace(_newRole) || !CreatableSet.Contains(_newRole))
        {
            Snackbar.Add("Vai trò được chọn không hợp lệ với trang này.", Severity.Warning);
            return;
        }

        var user = new ApplicationUser
        {
            UserName = _newEmail.Trim(),
            Email = _newEmail.Trim(),
            EmailConfirmed = true,
            FullName = _newFullName.Trim(),
            IsActive = true,
        };
        var result = await UserManager.CreateAsync(user, string.IsNullOrWhiteSpace(_newPassword) ? DbSeeder.DefaultAdminPassword : _newPassword);
        if (!result.Succeeded)
        {
            Snackbar.Add(string.Join("; ", result.Errors.Select(e => e.Description)), Severity.Error);
            return;
        }

        await UserManager.AddToRoleAsync(user, _newRole);

        await AddAuditAsync("create", "users", user.Id, null, new { user.Email, user.FullName, Role = _newRole });
        _newEmail = "";
        _newFullName = "";
        _newPassword = DbSeeder.DefaultAdminPassword;
        await LoadUsersAsync();
        Snackbar.Add("Đã tạo tài khoản.", Severity.Success);
    }

    private async Task OpenEditUserAsync(UserRow row)
    {
        var parameters = new DialogParameters<UserEditDialog> { { x => x.UserId, row.Id } };
        var dialog = await DialogService.ShowAsync<UserEditDialog>($"Sửa tài khoản — {row.FullName}", parameters);
        var result = await dialog.Result;
        if (result is not null && !result.Canceled)
            await LoadUsersAsync();
    }

    // Tài khoản super admin: vai trò cố định (kể cả super admin khác không đổi được). Ngoài ra khi RolesFixed=true thì mọi role đều cố định.
    // Vai trò ngoài phạm vi được phép tạo/gán ở trang này (VD: Đại lý/CTV ở trang Quản trị) cũng cố định — quản lý ở trang riêng.
    private static bool IsSuperAdminRow(UserRow row) => row.Roles.Contains(RoleNames.SuperAdmin);
    private bool IsRoleUnassignable(UserRow row) => row.PrimaryRole is not null && !CreatableSet.Contains(row.PrimaryRole);
    private bool IsRoleFixed(UserRow row) => RolesFixed || IsSuperAdminRow(row) || IsRoleUnassignable(row);

    private string FixedRoleHint(UserRow row) => IsSuperAdminRow(row)
        ? "Không thể chuyển vai trò của Super Admin — chỉ được sửa thông tin qua nút Sửa."
        : IsRoleUnassignable(row)
            ? "Vai trò này được quản lý ở trang riêng (VD: Đại lý & Hoa hồng) — không tạo/đổi ở đây."
            : "Vai trò này được cố định — chỉ được sửa thông tin qua nút Sửa, không đổi sang vai trò khác.";

    private async Task SaveUserRoleAsync(UserRow row)
    {
        if (!ShowRoleManagement)
        {
            Snackbar.Add("Trang này không cho phép chuyển vai trò tài khoản.", Severity.Warning);
            return;
        }

        var user = await UserManager.FindByIdAsync(row.Id.ToString());
        if (user is null || string.IsNullOrWhiteSpace(row.SelectedRole)) return;

        if (IsRoleFixed(row))
        {
            Snackbar.Add(FixedRoleHint(row), Severity.Warning);
            return;
        }
        // Chốt chặn: không cho đổi sang vai trò ngoài phạm vi được phép gán ở trang này.
        if (!CreatableSet.Contains(row.SelectedRole))
        {
            Snackbar.Add("Không thể chuyển sang vai trò ngoài phạm vi trang này.", Severity.Warning);
            return;
        }

        var oldRoles = await UserManager.GetRolesAsync(user);
        if (oldRoles.Count == 1 && oldRoles[0] == row.SelectedRole)
        {
            Snackbar.Add("Vai trò không thay đổi.", Severity.Info);
            return;
        }

        // Thao tác nhạy cảm (góp ý Vietgroup): bắt nhập lại mật khẩu của người thao tác trước khi đổi quyền.
        var roleLabel = RoleNames.All.GetValueOrDefault(row.SelectedRole, row.SelectedRole);
        var parameters = new DialogParameters<ConfirmPasswordDialog>
        {
            { x => x.Message, $"Bạn sắp đổi vai trò của \"{row.FullName}\" ({row.Email}) thành \"{roleLabel}\". Thao tác này thay đổi toàn bộ quyền truy cập của tài khoản." },
        };
        var dialog = await DialogService.ShowAsync<ConfirmPasswordDialog>("Xác nhận đổi vai trò", parameters);
        var result = await dialog.Result;
        if (result is null || result.Canceled) return;

        await UserManager.RemoveFromRolesAsync(user, oldRoles);
        await UserManager.AddToRoleAsync(user, row.SelectedRole);
        await AddAuditAsync("update_role", "users", user.Id, new { Roles = oldRoles }, new { Role = row.SelectedRole });
        await LoadUsersAsync();
        Snackbar.Add("Đã cập nhật vai trò.", Severity.Success);
    }

    private async Task ToggleUserAsync(UserRow row)
    {
        var user = await UserManager.FindByIdAsync(row.Id.ToString());
        if (user is null) return;
        var old = user.IsActive;
        user.IsActive = !user.IsActive;
        // Khi khóa, UpdateSecurityStampAsync lưu cả IsActive=false và stamp mới trong cùng Identity update.
        // Mọi cookie cũ sẽ bị revalidation từ chối; mở khóa chỉ cần cập nhật trạng thái.
        var result = user.IsActive
            ? await UserManager.UpdateAsync(user)
            : await UserManager.UpdateSecurityStampAsync(user);
        if (!result.Succeeded)
        {
            Snackbar.Add(string.Join("; ", result.Errors.Select(e => e.Description)), Severity.Error);
            return;
        }
        await AddAuditAsync(user.IsActive ? "unlock" : "lock", "users", user.Id, new { IsActive = old }, new { user.IsActive });
        await LoadUsersAsync();
        Snackbar.Add(user.IsActive ? "Đã mở khóa tài khoản." : "Đã khóa tài khoản.", Severity.Success);
    }

    // Xóa hẳn tài khoản (chỉ super admin, chỉ khi AllowDelete). Luôn hỏi xác nhận trước.
    private async Task DeleteUserAsync(UserRow row)
    {
        if (!AllowDelete || IsSuperAdminRow(row))
        {
            Snackbar.Add("Không thể xóa tài khoản này.", Severity.Warning);
            return;
        }

        var confirm = await DialogService.ShowMessageBoxAsync(
            "Xóa tài khoản?",
            $"Bạn có chắc muốn XÓA HẲN tài khoản \"{row.FullName}\" ({row.Email})? Thao tác này không thể hoàn tác.",
            yesText: "Xóa", cancelText: "Hủy");
        if (confirm != true) return;

        var user = await UserManager.FindByIdAsync(row.Id.ToString());
        if (user is null)
        {
            Snackbar.Add("Không tìm thấy tài khoản.", Severity.Error);
            return;
        }

        // Dọn mọi liên kết Học viên/Phụ huynh để Candidate không còn trỏ tới user đã xóa.
        await using (var db = await DbFactory.CreateDbContextAsync())
        {
            var linkedCandidates = await db.Candidates
                .Where(candidate => candidate.OwnerUserId == user.Id || candidate.ParentUserId == user.Id)
                .ToListAsync();
            foreach (var candidate in linkedCandidates)
            {
                if (CandidateAccountLinkRules.UnlinkUser(candidate, user.Id))
                    candidate.UpdatedAt = DateTimeOffset.UtcNow;
            }
            if (linkedCandidates.Count > 0) await db.SaveChangesAsync();
        }

        var result = await UserManager.DeleteAsync(user);
        if (!result.Succeeded)
        {
            Snackbar.Add(string.Join("; ", result.Errors.Select(e => e.Description)), Severity.Error);
            return;
        }

        await AddAuditAsync("delete", "users", user.Id, new { user.Email, user.FullName }, null);
        await LoadUsersAsync();
        Snackbar.Add("Đã xóa tài khoản.", Severity.Success);
    }

    private async Task AddAuditAsync(string action, string resource, Guid resourceId, object? oldValue, object? newValue)
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        db.AddAudit(await AuthState.GetUserIdAsync(), action, resource, resourceId, oldValue, newValue);
        await db.SaveChangesAsync();
    }

    private static string RoleDisplay(ApplicationRole role)
        => $"{role.Name} — {RoleNames.All.GetValueOrDefault(role.Name ?? "", role.Description ?? "")}";

    // Thứ tự + nhãn/icon/màu hiển thị cho từng bảng vai trò (cao → thấp).
    private static readonly (string Role, string Label, string Icon, Color Color)[] RoleOrder =
    {
        (RoleNames.SuperAdmin, "Quyền cao nhất (Super Admin)", Icons.Material.Filled.Shield, Color.Error),
        (RoleNames.Director, "Giám đốc", Icons.Material.Filled.Star, Color.Warning),
        (RoleNames.RecruitmentManager, "Trưởng phòng tuyển dụng", Icons.Material.Filled.SupervisorAccount, Color.Primary),
        (RoleNames.Recruiter, "Nhân viên tuyển dụng", Icons.Material.Filled.PersonSearch, Color.Info),
        (RoleNames.Consultant, "Tư vấn viên", Icons.Material.Filled.SupportAgent, Color.Secondary),
        (RoleNames.DocumentStaff, "Bộ phận hồ sơ", Icons.Material.Filled.FolderShared, Color.Secondary),
        (RoleNames.VisaStaff, "Bộ phận visa", Icons.Material.Filled.FlightTakeoff, Color.Tertiary),
        (RoleNames.Accountant, "Kế toán", Icons.Material.Filled.AccountBalance, Color.Success),
        (RoleNames.Agent, "Đại lý", Icons.Material.Filled.Handshake, Color.Dark),
        (RoleNames.Collaborator, "Cộng tác viên", Icons.Material.Filled.Diversity3, Color.Secondary),
        (RoleNames.Parent, "Phụ huynh", Icons.Material.Filled.FamilyRestroom, Color.Primary),
        (RoleNames.Student, "Học viên", Icons.Material.Filled.School, Color.Info),
    };

    private IEnumerable<(string Key, string Label, string Icon, Color Color, List<UserRow> Users)> GroupedUsers()
    {
        var managed = ManagedSet;
        var term = _search?.Trim() ?? "";
        foreach (var (role, label, icon, color) in RoleOrder)
        {
            if (!managed.Contains(role)) continue;
            var rows = _users.Where(u => u.PrimaryRole == role);
            if (term.Length > 0)
                rows = rows.Where(u =>
                    (u.FullName?.Contains(term, StringComparison.OrdinalIgnoreCase) ?? false)
                    || (u.Email?.Contains(term, StringComparison.OrdinalIgnoreCase) ?? false));
            yield return (role, label, icon, color, rows.ToList());
        }
    }

    private sealed class UserRow
    {
        public Guid Id { get; set; }
        public string Email { get; set; } = "";
        public string FullName { get; set; } = "";
        public bool IsActive { get; set; }
        public List<string> Roles { get; set; } = new();
        public string? PrimaryRole { get; set; }
        public string? SelectedRole { get; set; }
    }
}
