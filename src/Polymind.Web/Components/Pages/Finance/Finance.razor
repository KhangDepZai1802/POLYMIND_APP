        @if (_archivedGroups.Count > 0 || _archivedReceipts.Count > 0)
        {
            <MudTabPanel Text="@($"Kho lưu trữ ({_archivedGroups.Count + _archivedReceipts.Count})")" Icon="@Icons.Material.Filled.Inventory2">
                <MudAlert Severity="Severity.Info" Dense="true" Variant="Variant.Outlined" Class="mb-3">
                    Lưu trữ chỉ <b>ẩn khỏi bảng làm việc</b> — dữ liệu còn nguyên, <b>vẫn tính vào Tổng đã thu</b> ở đầu trang, và khôi phục lại được bất cứ lúc nào.
                </MudAlert>

                <div class="d-flex align-center mb-2" style="gap:8px">
                    <MudIcon Icon="@Icons.Material.Filled.AccountBalanceWallet" Color="Color.Primary" Size="Size.Small" />
                    <MudText Typo="Typo.subtitle1"><b>Khoản thu đã lưu trữ (@_archivedGroups.Count ứng viên)</b></MudText>
                </div>
                @if (_archivedGroups.Count == 0)
                {
                    <MudText Typo="Typo.body2" Class="mud-text-secondary py-3" Align="Align.Center">Chưa lưu trữ khoản thu nào.</MudText>
                }
                else
                {
                    <MudDataGrid T="PaymentGroupRow" Items="_archivedGroups" Hover="true" Dense="true" Striped="true">
                        <Columns>
                            <PropertyColumn Property="x => x.CandidateName" Title="Ứng viên" />
                            <TemplateColumn Title="Đã thu">
                                <CellTemplate><b>@($"{context.Item.Paid:N0} đ")</b></CellTemplate>
                            </TemplateColumn>
                            <TemplateColumn Title="Số bước">
                                <CellTemplate>@context.Item.PaidSteps/@PaymentPostingRules.TotalStages bước</CellTemplate>
