                                <CellTemplate>
                                    @if (_canArchivePayment)
                                    {
                                        <MudButton Size="Size.Small" Variant="Variant.Text" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Unarchive"
                                                   OnClick="@(() => RestoreSchedule(context.Item.CandidateId, context.Item.CandidateName))">Khôi phục</MudButton>
                                    }
                                </CellTemplate>
                            </TemplateColumn>
                        </Columns>
                        <PagerContent><MudDataGridPager T="PaymentGroupRow" /></PagerContent>
                    </MudDataGrid>
                }

                <div class="d-flex align-center mt-6 mb-2" style="gap:8px">
                    <MudIcon Icon="@Icons.Material.Filled.ReceiptLong" Color="Color.Secondary" Size="Size.Small" />
                    <MudText Typo="Typo.subtitle1"><b>Phiếu đã lưu trữ (@_archivedReceipts.Count)</b></MudText>
                </div>
                @if (_archivedReceipts.Count == 0)
                {
                    <MudText Typo="Typo.body2" Class="mud-text-secondary py-3" Align="Align.Center">Chưa lưu trữ phiếu nào.</MudText>
                }
                else
                {
                    <MudDataGrid T="ReceiptRow" Items="_archivedReceipts" Hover="true" Dense="true" Striped="true">
                        <Columns>
                            <PropertyColumn Property="x => x.Code" Title="Mã phiếu" />
                            <TemplateColumn Title="Loại">
                                <CellTemplate>
                                    <MudChip T="string" Size="Size.Small" Color="Labels.ColorOf(context.Item.Type)">@Labels.Vi(context.Item.Type)</MudChip>
                                </CellTemplate>
                            </TemplateColumn>
                            <PropertyColumn Property="x => x.PartyName" Title="Đối tượng" />
                            <TemplateColumn Title="Số tiền">
                                <CellTemplate>@($"{context.Item.Amount:N0} đ")</CellTemplate>
                            </TemplateColumn>
                            <TemplateColumn Title="Ngày">
                                <CellTemplate>@context.Item.Date.ToString("dd/MM/yyyy")</CellTemplate>
                            </TemplateColumn>
                            <TemplateColumn Title="" Sortable="false">
                                <CellTemplate>
                                    <MudButton Size="Size.Small" Variant="Variant.Text" Color="Color.Error"
                                               StartIcon="@Icons.Material.Filled.PictureAsPdf"
                                               OnClick="@(() => Nav.NavigateTo($"/receipts/{context.Item.Id}.pdf", forceLoad: true))">In PDF</MudButton>
                                    @if (_canArchiveReceipt)
                                    {
                                        <MudButton Size="Size.Small" Variant="Variant.Text" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Unarchive"
                                                   OnClick="@(() => RestoreReceipts(new List<Guid> { context.Item.Id }, context.Item.Code))">Khôi phục</MudButton>
                                    }
                                </CellTemplate>
                            </TemplateColumn>
                        </Columns>
                        <PagerContent><MudDataGridPager T="ReceiptRow" /></PagerContent>
                    </MudDataGrid>
                }
            </MudTabPanel>
        }
        }
    </MudTabs>
</MudPaper>

@code {
    private record PaymentRow(Guid Id, Guid CandidateId, string Code, string CandidateName, PaymentType Type, decimal Amount, PaymentStatus Status, DateOnly? DueDate, PaymentStage? Stage);

    /// <summary>Ba thao tác trên một khoản thu (Duyệt / Phiếu thu / Sửa) — dùng chung cho mọi bảng.</summary>
    private RenderFragment PaymentActions(PaymentRow p) =>@<div class="d-flex flex-wrap align-center justify-end" style="gap:2px">
        @if (_canRecordPayment && p.Status != PaymentStatus.Paid && p.Status != PaymentStatus.Refunded)
        {
            <MudButton Size="Size.Small" Color="Color.Success" Variant="Variant.Text"
                       StartIcon="@Icons.Material.Filled.Check" OnClick="@(() => ApprovePayment(p.Id))">Duyệt</MudButton>
        }
        @if (_canCreateReceipt && p.Status == PaymentStatus.Paid)
        {
            @if (_receiptPaymentIds.Contains(p.Id))
            {
                <MudTooltip Text="Đã có phiếu thu">
                    <MudIcon Icon="@Icons.Material.Filled.ReceiptLong" Color="Color.Success" Size="Size.Small" Class="mx-1" />
                </MudTooltip>
            }
            else
            {
                <MudButton Size="Size.Small" Color="Color.Info" Variant="Variant.Text"
                           StartIcon="@Icons.Material.Filled.ReceiptLong" OnClick="@(() => CreateReceiptForPayment(p))">Phiếu thu</MudButton>
            }
        }
        @if (_canUpdatePayment)
        {
            <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small" OnClick="@(() => OpenEditPayment(p.Id))" />
        }
    </div>;

    /// <summary>Tooltip cho bước bị khóa ở stepper Tiến độ: nêu đích danh bước ứng viên chưa nộp.</summary>
    private static string BlockedStageHint(ProgressRow row, PaymentStage stage)
    {
        var siblings = row.Stages
            .Where(s => s.Status is not null)
            .Select(s => (s.Stage, Status: s.Status!.Value));
        var blocking = PaymentPostingRules.UnsubmittedEarlierStages(stage, siblings);
        if (blocking.Count == 0) return $"{PaymentSchedule.StepLabel(stage)} — sẵn sàng nộp.";

        var missing = string.Join(", ", blocking.Select(PaymentSchedule.StepLabel));
        return $"Chưa nộp được {PaymentSchedule.StepLabel(stage)} vì còn thiếu: {missing}. "
             + $"Thứ tự bắt buộc: {PaymentSchedule.OrderHint()}.";
    }

    /// <summary>
    /// Màu chip bước: đã thu = xanh · tới lượt duyệt = xanh dương · còn chờ bước trước = xám (khóa).
    /// Cho kế toán thấy NGAY bước nào duyệt được, thay vì bấm rồi mới báo lỗi.
    /// </summary>
    private Color StageChipColor(PaymentRow row)
    {
        if (row.Status == PaymentStatus.Paid) return Color.Success;
        if (row.Stage is not PaymentStage stage) return Color.Default;

        var siblings = _payments
            .Where(p => p.CandidateId == row.CandidateId && p.Stage is not null)
            .Select(p => (Stage: p.Stage!.Value, p.Status));

        return PaymentPostingRules.HasUnpaidEarlierStage(stage, siblings)
            ? Color.Default   // bị khóa — còn bước trước chưa thu
            : Color.Primary;  // tới lượt
    }
    private record ReceiptRow(Guid Id, Guid? CandidateId, string Code, ReceiptType Type, string PartyName, decimal Amount, DateOnly Date, string? Description);

    /// <summary>Gom khoản thu theo lịch 4 bước về MỘT hàng/ứng viên; 4 bước nằm trong hàng mở rộng.</summary>
    private record PaymentGroupRow(Guid CandidateId, string CandidateName, List<PaymentRow> Stages)
    {
        public decimal Total => Stages.Sum(s => s.Amount);
        public decimal Paid => Stages.Where(s => s.Status == PaymentStatus.Paid).Sum(s => s.Amount);
        public int PaidSteps => Stages.Count(s => s.Status == PaymentStatus.Paid);
        public double Percent => Total <= 0 ? 0 : Math.Min(100, (double)(Paid * 100 / Total));

        /// <summary>Đủ điều kiện lưu trữ: kế toán đã duyệt cả 4 bước.</summary>
        public bool IsFullyPaid => PaymentPostingRules.CanArchiveSchedule(
            Stages.Where(s => s.Stage is not null).Select(s => (s.Stage!.Value, s.Status)));

        /// <summary>Bước kế tiếp cần thu = bước chưa thu đầu tiên (lịch ép tuần tự 1→4).</summary>
        public PaymentRow? NextDue => Stages
            .Where(s => s.Status != PaymentStatus.Paid && s.Status != PaymentStatus.Refunded)
            .OrderBy(s => (int)(s.Stage ?? 0))
            .FirstOrDefault();
    }

    /// <summary>Gom phiếu THU về MỘT hàng/ứng viên; từng phiếu (kèm nút In PDF) nằm trong hàng mở rộng.</summary>
    private record ReceiptGroupRow(Guid? CandidateId, string PartyName, List<ReceiptRow> Items)
    {
        public int Count => Items.Count;
        public decimal Total => Items.Sum(r => r.Amount);
        public DateOnly? LastDate => Items.Count == 0 ? null : Items.Max(r => r.Date);
    }

    /// <summary>So khớp không phân biệt hoa thường; ô tìm kiếm để trống thì khớp tất cả.</summary>
    private static bool Hit(string search, params string?[] fields)
        => string.IsNullOrWhiteSpace(search)
        || fields.Any(f => f?.Contains(search.Trim(), StringComparison.OrdinalIgnoreCase) == true);

    private bool MatchesPayment(PaymentRow p)
        => Hit(_paymentSearch, p.Code, p.CandidateName, Labels.Vi(p.Type), Labels.Vi(p.Status));

    // Khoản thu theo lịch 4 bước → gom 1 hàng/ứng viên (tránh 1 ứng viên chiếm 4 hàng).
    // Tìm kiếm giữ NGUYÊN cả 4 bước của ứng viên khớp — lọc lẻ từng bước sẽ làm hỏng tiến độ/tổng tiền của hàng.
    private List<PaymentGroupRow> ScheduledPaymentGroups => _payments
        .Where(p => p.Stage is not null)
        .GroupBy(p => (p.CandidateId, p.CandidateName))
        .Select(g => new PaymentGroupRow(
            g.Key.CandidateId,
            g.Key.CandidateName,
            g.OrderBy(p => (int)p.Stage!.Value).ToList()))
        .Where(g => Hit(_paymentSearch, g.CandidateName) || g.Stages.Any(MatchesPayment))
        .OrderBy(g => g.CandidateName)
        .ToList();

    // Khoản thu ngoài lịch 4 bước (thu lẻ) → giữ mỗi khoản 1 hàng.
    private List<PaymentRow> AdhocPayments => _payments
        .Where(p => p.Stage is null && MatchesPayment(p))
        .ToList();

    private bool MatchesReceipt(ReceiptRow r) => Hit(_receiptSearch, r.Code, r.PartyName, r.Description);

    // Phiếu THU → gom 1 hàng/ứng viên.
    private List<ReceiptGroupRow> IncomeReceiptGroups => _receipts
        .Where(r => r.Type == ReceiptType.Income)
        .GroupBy(r => (r.CandidateId, r.PartyName))
        .Select(g => new ReceiptGroupRow(
            g.Key.CandidateId,
            g.Key.PartyName,
            g.OrderByDescending(r => r.Date).ToList()))
        .Where(g => Hit(_receiptSearch, g.PartyName) || g.Items.Any(MatchesReceipt))
        .OrderByDescending(g => g.LastDate)
        .ToList();

    // Phiếu CHI → giữ nguyên như cũ, mỗi phiếu 1 hàng.
    private List<ReceiptRow> ExpenseReceipts => _receipts
        .Where(r => r.Type == ReceiptType.Expense && MatchesReceipt(r))
        .ToList();

    private record StageInfo(PaymentStage Stage, decimal Amount, Guid? PaymentId, PaymentStatus? Status);
    private record ProgressRow(Guid CandidateId, string CandidateName, string Code, Guid JobOrderId, string JobLabel,
        string? Country, decimal TotalCost, List<StageInfo> Stages, WorkflowStep Step)
    {
        public decimal Paid => Stages.Where(s => s.Status == PaymentStatus.Paid).Sum(s => s.Amount);
        public double Percent => TotalCost <= 0 ? 0 : Math.Min(100, (double)(Paid * 100 / TotalCost));
        public bool HasSchedule => Stages.Any(s => s.PaymentId != null);
        public int PaidSteps => Stages.Count(s => s.Status == PaymentStatus.Paid);

        /// <summary>Đủ điều kiện lưu trữ: đã tạo lịch VÀ kế toán duyệt xong cả 4 bước.</summary>
        public bool IsFullyPaid => HasSchedule && PaymentPostingRules.CanArchiveSchedule(
            Stages.Where(s => s.Status is not null).Select(s => (s.Stage, s.Status!.Value)));
    }

    private List<PaymentRow> _payments = new();
    private List<Expense> _expenses = new();
    private List<ReceiptRow> _receipts = new();
    private List<ProgressRow> _progress = new();
    private List<PaymentGroupRow> _archivedGroups = new();
    private List<ReceiptRow> _archivedReceipts = new();
    private string _progressSearch = "";
    private string _paymentSearch = "";
    private string _receiptSearch = "";
    private HashSet<Guid> _receiptPaymentIds = new();
    private HashSet<Guid> _receiptExpenseIds = new();
    private decimal _totalPaid, _totalPending, _totalExpense;
    private bool _canUpdatePayment, _canUpdateExpense, _canRecordPayment, _canCreatePayment;
    private bool _canCreateReceipt, _canReadReceipt;
    private bool _canArchivePayment, _canArchiveReceipt;
    private bool _selfScoped;
    private Guid? _ownedCandidateId;

    private IEnumerable<ProgressRow> FilteredProgress => _progress.Where(r =>
        string.IsNullOrWhiteSpace(_progressSearch)
        || r.CandidateName.Contains(_progressSearch, StringComparison.OrdinalIgnoreCase)
        || r.Code.Contains(_progressSearch, StringComparison.OrdinalIgnoreCase)
        || r.JobLabel.Contains(_progressSearch, StringComparison.OrdinalIgnoreCase));

    protected override async Task OnInitializedAsync()
    {
        var scope = await AgentScope.GetAsync();
        _selfScoped = scope.IsSelfScoped;
        _ownedCandidateId = scope.OwnedCandidateId;
        _canUpdatePayment = await HasPermission("payments:update");
        _canCreatePayment = await HasPermission("payments:create");
        _canUpdateExpense = await HasPermission("expenses:update");
        _canRecordPayment = await CanRecordPayment();
        _canCreateReceipt = await HasPermission("receipts:create");
        _canReadReceipt = await HasPermission("receipts:read");
        // Lưu trữ = thao tác sửa dữ liệu (ẩn/hiện), không phải chỉ đọc → dùng đúng quyền update.
        _canArchivePayment = !_selfScoped && _canUpdatePayment;
        _canArchiveReceipt = !_selfScoped && await HasPermission("receipts:update");
        await Load();
    }

    private async Task CreateReceiptForPayment(PaymentRow row)
    {
        if (!await HasPermission("receipts:create")) { Snackbar.Add("Bạn không có quyền tạo phiếu thu.", Severity.Warning); return; }
        await using var db = await DbFactory.CreateDbContextAsync();
        if (await db.Receipts.AnyAsync(r => r.PaymentId == row.Id)) { Snackbar.Add("Khoản thu này đã có phiếu.", Severity.Info); await Load(); return; }
        var p = await db.Payments.FirstOrDefaultAsync(x => x.Id == row.Id);
        if (p is null) return;
        var actorId = await AuthStateProvider.GetRequiredUserIdAsync(db);
        var receipt = new Receipt
        {
            Code = $"RC-{DateTime.Now:yyyyMMdd}-{Random.Shared.Next(1000, 9999)}",
            ReceiptType = ReceiptType.Income,
            CandidateId = p.CandidateId,
            PaymentId = p.Id,
            Amount = p.Amount,
            Description = $"Phiếu thu khoản {p.Code} ({Labels.Vi(p.PaymentType)})",
            ReceiptDate = p.PaidDate ?? DateOnly.FromDateTime(DateTime.UtcNow),
            CreatedBy = actorId,
        };
        db.Receipts.Add(receipt);
        p.ReceiptId = receipt.Id;
        p.UpdatedAt = DateTimeOffset.UtcNow;
        db.AddAudit(actorId, "create", "receipts", receipt.Id, null, new { receipt.Code, receipt.Amount, receipt.PaymentId });
        await db.SaveChangesAsync();
        Snackbar.Add($"Đã tạo phiếu thu {receipt.Code}", Severity.Success);
        await Load();
    }

    private async Task CreateReceiptForExpense(Expense expense)
    {
        if (!await HasPermission("receipts:create")) { Snackbar.Add("Bạn không có quyền tạo phiếu chi.", Severity.Warning); return; }
        await using var db = await DbFactory.CreateDbContextAsync();
        if (await db.Receipts.AnyAsync(r => r.ExpenseId == expense.Id)) { Snackbar.Add("Khoản chi này đã có phiếu.", Severity.Info); await Load(); return; }
        var actorId = await AuthStateProvider.GetRequiredUserIdAsync(db);
        var receipt = new Receipt
        {
            Code = $"RC-{DateTime.Now:yyyyMMdd}-{Random.Shared.Next(1000, 9999)}",
            ReceiptType = ReceiptType.Expense,
            ExpenseId = expense.Id,
            Amount = expense.Amount,
            Description = $"Phiếu chi {expense.Code} ({Labels.Vi(expense.Category)})",
            ReceiptDate = expense.ExpenseDate,
            CreatedBy = actorId,
        };
        db.Receipts.Add(receipt);
        db.AddAudit(actorId, "create", "receipts", receipt.Id, null, new { receipt.Code, receipt.Amount, receipt.ExpenseId });
        await db.SaveChangesAsync();
        Snackbar.Add($"Đã tạo phiếu chi {receipt.Code}", Severity.Success);
        await Load();
    }

    private async Task ApprovePayment(Guid id)
    {
        if (!await CanRecordPayment()) { Snackbar.Add("Bạn không có quyền ghi nhận khoản thu.", Severity.Warning); return; }
        await using var db = await DbFactory.CreateDbContextAsync();
        var p = await db.Payments.FirstOrDefaultAsync(x => x.Id == id);
        if (p is null) return;
        var actorId = await AuthStateProvider.GetRequiredUserIdAsync(db);
        var posting = await PaymentPostingService.MarkPaidAsync(db, p, actorId);
        if (!posting.Succeeded)
        {
            Snackbar.Add(posting.Error!, Severity.Warning);
            return;
        }
        Snackbar.Add(posting.ReceiptCode is null
            ? "Đã duyệt & ghi nhận khoản thu"
            : $"Đã duyệt khoản thu và lập phiếu thu {posting.ReceiptCode} — vào tab “Phiếu thu/chi” để in.", Severity.Success);
        if (posting.NewCommissions > 0)
            Snackbar.Add($"Đã phát sinh {posting.NewCommissions} lát hoa hồng cho đại lý.", Severity.Info);
        await Load();
    }

    private async Task Load()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        var eligibleCandidateIds = await FinanceEligibility.CandidateIdsAsync(db);
        if (_selfScoped)
        {
            // Cổng cá nhân hóa: chỉ giữ đúng ứng viên gắn với tài khoản.
            eligibleCandidateIds = _ownedCandidateId is Guid oid && eligibleCandidateIds.Contains(oid)
                ? new HashSet<Guid> { oid }
                : new HashSet<Guid>();
        }
        var names = await db.Candidates.ToDictionaryAsync(c => c.Id, c => c.FullName);
        var payments = await db.Payments
            .Where(p => eligibleCandidateIds.Contains(p.CandidateId))
            .OrderByDescending(p => p.CreatedAt)
            .ToListAsync();

        PaymentRow ToRow(Payment p) => new(
            p.Id, p.CandidateId, p.Code, names.GetValueOrDefault(p.CandidateId, "—"),
            p.PaymentType, p.Amount, p.Status, p.DueDate, p.Stage);

        // Đã lưu trữ = ẩn khỏi bảng làm việc, KHÔNG trừ khỏi tổng tiền (xem FinanceArchiveService).
        var active = payments.Where(p => p.ArchivedAt is null).ToList();
        _payments = active.Select(ToRow).ToList();
        _archivedGroups = payments
            .Where(p => p.ArchivedAt is not null && p.Stage is not null)
            .Select(ToRow)
            .GroupBy(p => (p.CandidateId, p.CandidateName))
            .Select(g => new PaymentGroupRow(g.Key.CandidateId, g.Key.CandidateName,
                g.OrderBy(p => (int)p.Stage!.Value).ToList()))
            .OrderBy(g => g.CandidateName)
            .ToList();

        _expenses = await db.Expenses.OrderByDescending(e => e.ExpenseDate).ToListAsync();

        _totalPaid = payments.Where(p => p.Status == PaymentStatus.Paid).Sum(p => p.Amount);
        _totalPending = payments
            .Where(p => p.Status is PaymentStatus.Pending or PaymentStatus.Partial or PaymentStatus.Overdue or PaymentStatus.Submitted)
            .Sum(p => p.Amount);
        _totalExpense = _expenses.Sum(e => e.Amount);

        var receipts = await db.Receipts
            .Where(r => r.CandidateId == null || eligibleCandidateIds.Contains(r.CandidateId.Value))
            .OrderByDescending(r => r.ReceiptDate)
            .ThenByDescending(r => r.CreatedAt)
            .ToListAsync();

        ReceiptRow ToReceiptRow(Receipt r) => new(
            r.Id, r.CandidateId, r.Code, r.ReceiptType,
            r.CandidateId is not null ? names.GetValueOrDefault(r.CandidateId.Value, "—") : "—",
            r.Amount, r.ReceiptDate, r.Description);

        _receipts = receipts.Where(r => r.ArchivedAt is null).Select(ToReceiptRow).ToList();
        _archivedReceipts = receipts.Where(r => r.ArchivedAt is not null).Select(ToReceiptRow).ToList();
        _receiptPaymentIds = receipts.Where(r => r.PaymentId is not null).Select(r => r.PaymentId!.Value).ToHashSet();
        _receiptExpenseIds = receipts.Where(r => r.ExpenseId is not null).Select(r => r.ExpenseId!.Value).ToHashSet();

        var archivedCandidates = payments
            .Where(p => p.ArchivedAt is not null && p.Stage is not null)
            .Select(p => p.CandidateId)
            .ToHashSet();

        await LoadProgress(db, active, archivedCandidates);
    }

    // Tiến độ đóng tiền: mỗi ứng viên đã xếp vào đơn hàng → tổng phải đóng = chi phí đơn hàng, chia 4 bước.
    private async Task LoadProgress(ApplicationDbContext db, List<Payment> allPayments, HashSet<Guid> archivedCandidates)
    {
        var candInfo = await db.Candidates.ToDictionaryAsync(c => c.Id, c => new { c.FullName, c.Code });
        var jobInfo = await db.JobOrders.ToDictionaryAsync(j => j.Id,
            j => new { j.Code, j.Country, j.CompanyName, j.Field, j.CostAmount });

        // Đơn hàng gần nhất của mỗi ứng viên (1 ứng viên có thể gắn nhiều đơn — lấy mới nhất).
        var latestByCandidate = await db.CandidateJobOrders
            .OrderByDescending(c => c.CreatedAt)
            .Select(c => new { c.CandidateId, c.JobOrderId, c.CurrentStep, c.CreatedAt })
            .ToListAsync();
        var assignments = latestByCandidate
            .GroupBy(a => a.CandidateId)
            .Select(g => g.First())
            .Where(a => a.CurrentStep >= WorkflowStep.Deposit)
            // Ứng viên đã đưa lịch đóng tiền vào kho lưu trữ thì biến mất khỏi Tiến độ (cùng lúc với Khoản thu),
            // nếu không sẽ hiện lại như "chưa tạo lịch" và mời tạo lịch lần hai.
            .Where(a => !archivedCandidates.Contains(a.CandidateId))
            .ToList();

        var stageByCandidate = allPayments
            .Where(p => p.Stage != null)
            .GroupBy(p => p.CandidateId)
            .ToDictionary(g => g.Key, g => g.ToList());

        _progress = assignments.Select(a =>
        {
            var job = jobInfo.GetValueOrDefault(a.JobOrderId);
            var total = job?.CostAmount ?? 0m;
            var computed = PaymentSchedule.Split(total);
            var existing = stageByCandidate.GetValueOrDefault(a.CandidateId) ?? new List<Payment>();
            var stages = PaymentSchedule.Stages.Select(s =>
            {
                var pay = existing.FirstOrDefault(p => p.Stage == s.Stage);
                var amount = pay?.Amount ?? computed.GetValueOrDefault(s.Stage);
                return new StageInfo(s.Stage, amount, pay?.Id, pay?.Status);
            }).ToList();
            var jobLabel = job is null ? "" : (string.IsNullOrWhiteSpace(job.CompanyName) ? job.Code : job.CompanyName!);
            return new ProgressRow(
                a.CandidateId,
                candInfo.GetValueOrDefault(a.CandidateId)?.FullName ?? "—",
                candInfo.GetValueOrDefault(a.CandidateId)?.Code ?? "",
                a.JobOrderId, jobLabel, job?.Country, total, stages, a.CurrentStep);
        })
        .OrderByDescending(r => r.TotalCost > 0)
        .ThenByDescending(r => r.Percent)
        .ThenBy(r => r.CandidateName)
        .ToList();

        // Cổng cá nhân hóa: chỉ hiển thị tiến độ của đúng ứng viên gắn với tài khoản.
        if (_selfScoped)
            _progress = _ownedCandidateId is Guid oid
                ? _progress.Where(r => r.CandidateId == oid).ToList()
                : new List<ProgressRow>();
    }

    // Tạo 4 khoản thu (1 cho mỗi bước) cho ứng viên theo lịch — idempotent (chỉ tạo bước còn thiếu).
    private async Task CreateSchedule(ProgressRow row)
    {
        if (!await HasPermission("payments:create")) { Snackbar.Add("Bạn không có quyền tạo khoản thu.", Severity.Warning); return; }
        if (row.TotalCost <= 0) { Snackbar.Add("Đơn hàng chưa có chi phí.", Severity.Warning); return; }
        await using var db = await DbFactory.CreateDbContextAsync();
        var actorId = await AuthStateProvider.GetRequiredUserIdAsync(db);
        var existingStages = await db.Payments
            .Where(p => p.CandidateId == row.CandidateId && p.Stage != null)
            .Select(p => p.Stage!.Value)
            .ToListAsync();
        var amounts = PaymentSchedule.Split(row.TotalCost);
        var created = 0;
        foreach (var (stage, _) in PaymentSchedule.Stages)
        {
            if (existingStages.Contains(stage)) continue;
            var payment = new Payment
            {
                Code = $"PT-{DateTime.Now:yyyyMMdd}-{Random.Shared.Next(1000, 9999)}",
                CandidateId = row.CandidateId,
                JobOrderId = row.JobOrderId,
                PaymentType = Labels.TypeOf(stage),
                Stage = stage,
                Amount = amounts.GetValueOrDefault(stage),
                Status = PaymentStatus.Pending,
                Notes = $"Bước {(int)stage} — {Labels.Vi(stage)} ({PaymentSchedule.Percent(stage)}% chi phí đơn hàng)",
                CreatedBy = actorId,
            };
            db.Payments.Add(payment);
            db.AddAudit(actorId, "create", "payments", payment.Id, null, new { payment.Code, payment.Amount, Stage = stage.ToString() });
            created++;
        }
        if (created == 0) { Snackbar.Add("Ứng viên đã có đủ lịch đóng tiền.", Severity.Info); return; }
        await db.SaveChangesAsync();
        Snackbar.Add($"Đã tạo lịch đóng tiền 4 bước cho {row.CandidateName}", Severity.Success);
        await Load();
    }

    /// <summary>
    /// Tiến độ đóng tiền: xác nhận ứng viên ĐÃ NỘP tiền bước này — KHÔNG duyệt thay kế toán.
    /// Khoản thu chuyển sang "Đã nộp — chờ duyệt"; kế toán vào tab Khoản thu bấm Duyệt mới hạch toán
    /// và mới sinh phiếu thu + hoa hồng.
    /// </summary>
    private async Task MarkStageSubmitted(Guid paymentId)
    {
        if (!await CanRecordPayment()) { Snackbar.Add("Bạn không có quyền ghi nhận khoản thu.", Severity.Warning); return; }
        await using var db = await DbFactory.CreateDbContextAsync();
        var p = await db.Payments.FirstOrDefaultAsync(x => x.Id == paymentId);
        if (p is null) return;
        var actorId = await AuthStateProvider.GetRequiredUserIdAsync(db);
        var posting = await PaymentPostingService.MarkSubmittedAsync(db, p, actorId);
        if (!posting.Succeeded)
        {
            Snackbar.Add(posting.Error!, Severity.Warning);
            return;
        }

        var what = p.Stage is PaymentStage st ? PaymentSchedule.StepLabel(st) : "khoản thu";
        Snackbar.Add($"Đã ghi nhận ứng viên nộp {what}. Kế toán duyệt ở tab “Khoản thu”.", Severity.Success);
        await Load();
    }

    // ===== Kho lưu trữ — chỉ ẩn khỏi bảng làm việc, không xóa và không miễn nợ (xem FinanceArchiveService) =====

    private async Task ArchiveSchedule(Guid candidateId, string candidateName)
    {
        if (!await HasPermission("payments:update")) { Snackbar.Add("Bạn không có quyền lưu trữ khoản thu.", Severity.Warning); return; }
        if (!await Confirm($"Đưa toàn bộ khoản thu của {candidateName} vào kho lưu trữ?",
                "Khoản thu sẽ ẩn khỏi Tiến độ đóng tiền và Khoản thu. Phiếu thu/chi KHÔNG bị ảnh hưởng. Khôi phục lại được bất cứ lúc nào."))
            return;

        await using var db = await DbFactory.CreateDbContextAsync();
        var actorId = await AuthStateProvider.GetRequiredUserIdAsync(db);
        var result = await FinanceArchiveService.ArchiveScheduleAsync(db, candidateId, actorId);
        if (!result.Succeeded) { Snackbar.Add(result.Error!, Severity.Warning); return; }

        Snackbar.Add($"Đã lưu trữ {result.Affected} khoản thu của {candidateName}.", Severity.Success);
        await Load();
    }

