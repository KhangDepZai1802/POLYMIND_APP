@page "/finance"
@attribute [Authorize(Policy = "payments:read")]
@inject IDbContextFactory<ApplicationDbContext> DbFactory
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject IAuthorizationService AuthorizationService
@inject AuthenticationStateProvider AuthStateProvider
@inject NavigationManager Nav
@inject AgentScope AgentScope
@using Polymind.Infrastructure.Persistence.Constants
@using Polymind.Web.Finance
@using Polymind.Domain.Finance

<PageTitle>Tài chính — POLYMIND</PageTitle>

@if (_selfScoped)
{
    <PageHeader Eyebrow="TÀI CHÍNH" Title="Đóng tiền của tôi" Subtitle="Tiến độ nghĩa vụ đóng tiền theo chi phí đơn hàng" />
}
else
{
    <PageHeader Eyebrow="TÀI CHÍNH" Title="Tài chính & Công nợ" Subtitle="Quản lý khoản thu từ ứng viên và khoản chi vận hành" />
}

<MudGrid Class="mb-2" Style="@(_selfScoped ? "display:none" : "")">
    <MudItem xs="12" sm="4">
        <MudPaper Class="pa-4" Elevation="1">
            <MudText Typo="Typo.caption" Class="mud-text-secondary">Tổng đã thu</MudText>
            <MudText Typo="Typo.h6" Color="Color.Success"><b>@($"{_totalPaid:N0} đ")</b></MudText>
        </MudPaper>
    </MudItem>
    <MudItem xs="12" sm="4">
        <MudPaper Class="pa-4" Elevation="1">
            <MudText Typo="Typo.caption" Class="mud-text-secondary">Còn phải thu</MudText>
            <MudText Typo="Typo.h6" Color="Color.Warning"><b>@($"{_totalPending:N0} đ")</b></MudText>
        </MudPaper>
    </MudItem>
    <MudItem xs="12" sm="4">
        <MudPaper Class="pa-4" Elevation="1">
            <MudText Typo="Typo.caption" Class="mud-text-secondary">Tổng đã chi</MudText>
            <MudText Typo="Typo.h6" Color="Color.Error"><b>@($"{_totalExpense:N0} đ")</b></MudText>
        </MudPaper>
    </MudItem>
</MudGrid>

<MudPaper Elevation="1" Class="pa-2">
    <MudTabs Elevation="0" Rounded="true" ApplyEffectsToContainer="true" Class="pa-2">
        <MudTabPanel Text="@($"Tiến độ đóng tiền ({_progress.Count})")" Icon="@Icons.Material.Filled.AccountBalanceWallet">
            <MudAlert Severity="Severity.Info" Dense="true" Variant="Variant.Outlined" Class="mb-3">
                Mỗi ứng viên đã được xếp vào đơn hàng phải đóng tổng = <b>chi phí đơn hàng</b>, chia <b>4 bước</b>:
                Đặt cọc (20%) → Phí dịch vụ (30%) → Phí trước xuất cảnh (30%) → Tất toán (20%). Ứng viên hoàn tất khi đóng đủ 4 bước.
            </MudAlert>
            @if (!_selfScoped)
            {
                <MudTextField @bind-Value="_progressSearch" Placeholder="Tìm theo tên / mã ứng viên / đơn hàng..." Adornment="Adornment.Start"
                              AdornmentIcon="@Icons.Material.Filled.Search" Immediate="true" Variant="Variant.Outlined" Margin="Margin.Dense" Class="mb-3" />
            }
            @if (!FilteredProgress.Any())
            {
                <MudText Typo="Typo.body2" Class="mud-text-secondary py-4" Align="Align.Center">Chưa có ứng viên nào đã đến bước đặt cọc.</MudText>
            }
            else
            {
                @foreach (var row in FilteredProgress)
                {
                    var ct = CountryDisplay.Of(row.Country);
                    <MudPaper Class="mobile-card pa-3 mb-3" Elevation="0">
                        <div class="d-flex justify-space-between align-center flex-wrap" style="gap:8px">
                            <div style="min-width:0">
                                <MudText Typo="Typo.subtitle1" Style="font-weight:600">@row.CandidateName</MudText>
                                <MudText Typo="Typo.caption" Class="mud-text-secondary">@row.Code • <CountryFlag Style="ct" Size="16" /> @ct.Name @(string.IsNullOrWhiteSpace(row.JobLabel) ? "" : $"• {row.JobLabel}")</MudText>
                            </div>
                            <div style="text-align:right">
                                <MudText Typo="Typo.subtitle2" Style="font-weight:700">@($"{row.Paid:N0}") / @($"{row.TotalCost:N0} đ")</MudText>
                                <MudText Typo="Typo.caption" Class="mud-text-secondary">@row.PaidSteps/4 bước • @($"{row.Percent:0}%")@(row.Percent >= 100 ? " ✔ Hoàn tất" : "")</MudText>
                            </div>
                        </div>
                        <MudProgressLinear Color="@(row.Percent >= 100 ? Color.Success : Color.Primary)" Value="@row.Percent" Class="my-2" Style="height:10px" Rounded="true" />
                        @if (row.TotalCost <= 0)
                        {
                            <MudAlert Severity="Severity.Warning" Dense="true" Class="my-1">Đơn hàng chưa nhập chi phí — chưa tính được lịch đóng tiền. Vào trang Jobs để bổ sung chi phí.</MudAlert>
                        }
                        else
                        {
                            @* Ứng viên phải NỘP tuần tự 1→4: bước kế tiếp = bước đầu tiên chưa nộp. *@
                            var nextStage = row.Stages.FirstOrDefault(x => x.Status is null || !PaymentPostingRules.IsSubmittedOrPaid(x.Status.Value))?.Stage;
                            <div class="pm-stage-track">
                                @foreach (var s in row.Stages)
                                {
                                    var paid = s.Status == PaymentStatus.Paid;
                                    var submitted = s.Status == PaymentStatus.Submitted;
                                    var isNext = s.Stage == nextStage;
                                    <div class="pm-stage @(paid ? "pm-stage--paid" : "")">
                                        <MudIcon Icon="@Labels.IconOf(s.Stage)" Size="Size.Small" Color="@(paid ? Color.Success : submitted ? Color.Info : Color.Default)" />
                                        <div class="pm-stage-label">@((int)s.Stage). @Labels.ShortVi(s.Stage) <span class="mud-text-secondary">(@PaymentSchedule.Percent(s.Stage)%)</span></div>
                                        <div class="pm-stage-amount">@($"{s.Amount:N0} đ")</div>
                                        @if (paid)
                                        {
                                            <MudChip T="string" Size="Size.Small" Color="Color.Success" Variant="Variant.Filled" Icon="@Icons.Material.Filled.Check">Kế toán đã duyệt</MudChip>
                                        }
                                        else if (submitted)
                                        {
                                            @* Đã nộp nhưng CHƯA hạch toán — kế toán duyệt riêng bên tab Khoản thu. *@
                                            <MudTooltip Text="Ứng viên đã nộp tiền. Kế toán duyệt khoản thu này ở tab “Khoản thu”.">
                                                <MudChip T="string" Size="Size.Small" Color="Color.Info" Variant="Variant.Filled" Icon="@Icons.Material.Filled.HourglassTop">Đã nộp — chờ duyệt</MudChip>
                                            </MudTooltip>
                                        }
                                        else if (s.PaymentId is Guid pid && isNext)
                                        {
                                            @if (_canRecordPayment)
                                            {
                                                <MudButton Size="Size.Small" Variant="Variant.Filled" Color="Color.Primary" OnClick="@(() => MarkStageSubmitted(pid))">Xác nhận đã nộp</MudButton>
                                            }
                                            else
                                            {
                                                <MudChip T="string" Size="Size.Small" Color="Color.Warning" Variant="Variant.Outlined">Chờ đóng</MudChip>
                                            }
                                        }
                                        else if (s.PaymentId is not null)
                                        {
                                            @* Chưa tới lượt: nêu ĐÍCH DANH bước còn thiếu, không nói chung chung. *@
                                            <MudTooltip Text="@BlockedStageHint(row, s.Stage)">
                                                <MudChip T="string" Size="Size.Small" Color="Color.Default" Variant="Variant.Outlined" Icon="@Icons.Material.Filled.Lock">Chưa tới lượt</MudChip>
                                            </MudTooltip>
                                        }
                                        else
                                        {
                                            <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined">Chưa tạo</MudChip>
                                        }
                                    </div>
                                }
                            </div>
                            <div class="d-flex justify-end mt-2" style="gap:8px">
                                @if (!row.HasSchedule && _canCreatePayment)
                                {
                                    <MudButton Size="Size.Small" Variant="Variant.Filled" Color="Color.Secondary" StartIcon="@Icons.Material.Filled.PlaylistAddCheck"
                                               OnClick="@(() => CreateSchedule(row))">Tạo lịch đóng tiền 4 bước</MudButton>
                                }
                                @if (row.IsFullyPaid && _canArchivePayment)
                                {
                                    <MudButton Size="Size.Small" Variant="Variant.Outlined" Color="Color.Success" StartIcon="@Icons.Material.Filled.Inventory2"
                                               OnClick="@(() => ArchiveSchedule(row.CandidateId, row.CandidateName))">Đưa vào kho lưu trữ</MudButton>
                                }
                            </div>
                        }
                    </MudPaper>
                }
            }
        </MudTabPanel>

        @if (!_selfScoped)
        {
        <MudTabPanel Text="@($"Khoản thu ({_payments.Count})")">
            <MudTextField @bind-Value="_paymentSearch" Placeholder="Tìm theo tên ứng viên / mã khoản thu / loại / trạng thái..." Adornment="Adornment.Start"
                          AdornmentIcon="@Icons.Material.Filled.Search" Immediate="true" Clearable="true"
                          Variant="Variant.Outlined" Margin="Margin.Dense" Class="mb-3" />

            @* ===== Bảng 1 — Theo lịch 4 bước: MỖI ỨNG VIÊN 1 HÀNG, bấm mũi tên để xem chi tiết 4 bước ===== *@
            <div class="d-flex align-center mb-2" style="gap:8px">
                <MudIcon Icon="@Icons.Material.Filled.AccountBalanceWallet" Color="Color.Primary" Size="Size.Small" />
                <MudText Typo="Typo.subtitle1"><b>Theo lịch đóng tiền (@ScheduledPaymentGroups.Count ứng viên)</b></MudText>
                <MudText Typo="Typo.caption" Class="mud-text-secondary">— bấm ▸ để xem 4 bước</MudText>
            </div>
            @if (ScheduledPaymentGroups.Count == 0)
            {
                <MudText Typo="Typo.body2" Class="mud-text-secondary py-3" Align="Align.Center">
                    @(string.IsNullOrWhiteSpace(_paymentSearch) ? "Chưa có ứng viên nào có lịch đóng tiền." : $"Không tìm thấy khoản thu theo lịch nào khớp “{_paymentSearch}”.")
                </MudText>
            }
            else
            {
                <MudDataGrid T="PaymentGroupRow" Items="ScheduledPaymentGroups" Hover="true" Dense="true" Striped="true">
                    <Columns>
                        <HierarchyColumn T="PaymentGroupRow" />
                        <PropertyColumn Property="x => x.CandidateName" Title="Ứng viên" />
                        <TemplateColumn Title="Tiến độ">
                            <CellTemplate>
                                <div style="min-width:130px">
                                    <MudProgressLinear Color="@(context.Item.PaidSteps == PaymentPostingRules.TotalStages ? Color.Success : Color.Primary)"
                                                       Value="@context.Item.Percent" Style="height:8px" Rounded="true" />
                                    <MudText Typo="Typo.caption" Class="mud-text-secondary">
                                        @context.Item.PaidSteps/@PaymentPostingRules.TotalStages bước • @($"{context.Item.Percent:0}%")
                                    </MudText>
                                </div>
                            </CellTemplate>
                        </TemplateColumn>
                        <TemplateColumn Title="Đã thu / Tổng">
                            <CellTemplate>
                                <b>@($"{context.Item.Paid:N0}")</b> <span class="mud-text-secondary">/ @($"{context.Item.Total:N0} đ")</span>
                            </CellTemplate>
                        </TemplateColumn>
                        <TemplateColumn Title="Bước kế tiếp">
                            <CellTemplate>
                                @if (context.Item.NextDue is PaymentRow next && next.Stage is PaymentStage ns)
                                {
                                    <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="@StageChipColor(next)" Icon="@Labels.IconOf(ns)">
                                        @PaymentSchedule.StepBadge(ns) — @Labels.ShortVi(ns)
                                    </MudChip>
                                }
                                else
                                {
                                    <MudChip T="string" Size="Size.Small" Color="Color.Success" Icon="@Icons.Material.Filled.Check">Đã thu đủ</MudChip>
                                }
                            </CellTemplate>
                        </TemplateColumn>
                        <TemplateColumn Title="" Sortable="false">
                            <CellTemplate>
                                @if (context.Item.NextDue is PaymentRow due)
                                {
                                    @PaymentActions(due)
                                }
                                else if (context.Item.IsFullyPaid && _canArchivePayment)
                                {
                                    <MudButton Size="Size.Small" Variant="Variant.Text" Color="Color.Success" StartIcon="@Icons.Material.Filled.Inventory2"
                                               OnClick="@(() => ArchiveSchedule(context.Item.CandidateId, context.Item.CandidateName))">Lưu trữ</MudButton>
                                }
                            </CellTemplate>
                        </TemplateColumn>
                    </Columns>
                    <ChildRowContent>
                        <MudSimpleTable Dense="true" Striped="true" Class="ma-2">
                            <thead>
                                <tr>
                                    <th>Bước</th>
                                    <th>Mã</th>
                                    <th style="text-align:right">Số tiền</th>
                                    <th>Hạn thu</th>
                                    <th>Trạng thái</th>
                                    <th style="text-align:right">Thao tác</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var p in context.Item.Stages)
                                {
                                    <tr>
                                        <td>
                                            @if (p.Stage is PaymentStage st)
                                            {
                                                <MudTooltip Text="@($"Lịch đóng tiền: {PaymentSchedule.OrderHint()}")">
                                                    <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined"
                                                             Color="@StageChipColor(p)" Icon="@Labels.IconOf(st)">
                                                        @PaymentSchedule.StepBadge(st) — @Labels.ShortVi(st)
                                                    </MudChip>
                                                </MudTooltip>
                                            }
                                        </td>
                                        <td>@p.Code</td>
                                        <td style="text-align:right">@($"{p.Amount:N0} đ")</td>
                                        <td>@(p.DueDate?.ToString("dd/MM/yyyy") ?? "—")</td>
                                        <td><MudChip T="string" Size="Size.Small" Color="Labels.ColorOf(p.Status)">@Labels.Vi(p.Status)</MudChip></td>
                                        <td style="text-align:right">@PaymentActions(p)</td>
                                    </tr>
                                }
                            </tbody>
                        </MudSimpleTable>
                    </ChildRowContent>
                    <PagerContent><MudDataGridPager T="PaymentGroupRow" /></PagerContent>
                </MudDataGrid>
            }

            @* ===== Bảng 2 — Thu lẻ: ngoài lịch 4 bước, giữ mỗi khoản 1 hàng =====
                 Nút "Thêm khoản thu" nằm Ở ĐÂY (không ở đầu tab): khoản thu tạo tay luôn không có Stage
                 nên chắc chắn rơi vào bảng này — để trên đầu dễ hiểu lầm là thêm vào lịch 4 bước. *@
            <div class="d-flex align-center justify-space-between flex-wrap mt-6 mb-2" style="gap:8px">
                <div class="d-flex align-center" style="gap:8px">
                    <MudIcon Icon="@Icons.Material.Filled.Payments" Color="Color.Secondary" Size="Size.Small" />
                    <MudText Typo="Typo.subtitle1"><b>Khoản thu lẻ (@AdhocPayments.Count)</b></MudText>
                    <MudText Typo="Typo.caption" Class="mud-text-secondary">— ngoài lịch 4 bước, duyệt độc lập</MudText>
                </div>
                <AuthorizeView Policy="payments:create">
                    <Authorized>
                        <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" OnClick="OpenCreatePayment">
                            Thêm khoản thu lẻ
                        </MudButton>
                    </Authorized>
                </AuthorizeView>
            </div>
            @if (AdhocPayments.Count == 0)
            {
                <MudText Typo="Typo.body2" Class="mud-text-secondary py-3" Align="Align.Center">
                    @(string.IsNullOrWhiteSpace(_paymentSearch) ? "Chưa có khoản thu lẻ nào." : $"Không tìm thấy khoản thu lẻ nào khớp “{_paymentSearch}”.")
                </MudText>
            }
            else
            {
                <MudDataGrid T="PaymentRow" Items="AdhocPayments" Hover="true" Dense="true" Striped="true">
                    <Columns>
                        <PropertyColumn Property="x => x.Code" Title="Mã" />
                        <PropertyColumn Property="x => x.CandidateName" Title="Ứng viên" />
                        <TemplateColumn Title="Loại">
                            <CellTemplate>@Labels.Vi(context.Item.Type)</CellTemplate>
                        </TemplateColumn>
                        <TemplateColumn Title="Số tiền">
                            <CellTemplate>@($"{context.Item.Amount:N0} đ")</CellTemplate>
                        </TemplateColumn>
                        <TemplateColumn Title="Trạng thái">
                            <CellTemplate>
                                <MudChip T="string" Size="Size.Small" Color="Labels.ColorOf(context.Item.Status)">@Labels.Vi(context.Item.Status)</MudChip>
                            </CellTemplate>
                        </TemplateColumn>
                        <TemplateColumn Title="Hạn thu">
                            <CellTemplate>@(context.Item.DueDate?.ToString("dd/MM/yyyy") ?? "—")</CellTemplate>
                        </TemplateColumn>
                        <TemplateColumn Title="" Sortable="false">
                            <CellTemplate>@PaymentActions(context.Item)</CellTemplate>
                        </TemplateColumn>
                    </Columns>
                    <PagerContent><MudDataGridPager T="PaymentRow" /></PagerContent>
                </MudDataGrid>
            }
        </MudTabPanel>

        <MudTabPanel Text="@($"Khoản chi ({_expenses.Count})")">
            <div class="d-flex justify-end mb-3">
                <AuthorizeView Policy="expenses:create">
                    <Authorized>
                        <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" OnClick="OpenCreateExpense">
                            Thêm khoản chi
                        </MudButton>
                    </Authorized>
                </AuthorizeView>
            </div>
            <MudHidden Breakpoint="Breakpoint.SmAndDown">
                <MudDataGrid T="Expense" Items="_expenses" Hover="true" Dense="true" Striped="true">
                    <Columns>
                        <PropertyColumn Property="x => x.Code" Title="Mã" />
                        <TemplateColumn Title="Loại">
                            <CellTemplate>@Labels.Vi(context.Item.Category)</CellTemplate>
                        </TemplateColumn>
                        <PropertyColumn Property="x => x.Description" Title="Mô tả" />
                        <TemplateColumn Title="Số tiền">
                            <CellTemplate>@($"{context.Item.Amount:N0} đ")</CellTemplate>
                        </TemplateColumn>
                        <TemplateColumn Title="Ngày chi">
                            <CellTemplate>@context.Item.ExpenseDate.ToString("dd/MM/yyyy")</CellTemplate>
                        </TemplateColumn>
                        <TemplateColumn Title="" Sortable="false">
                            <CellTemplate>
                                @if (_canCreateReceipt)
                                {
                                    @if (_receiptExpenseIds.Contains(context.Item.Id))
                                    {
                                        <MudTooltip Text="Đã có phiếu chi"><MudIcon Icon="@Icons.Material.Filled.ReceiptLong" Color="Color.Success" Size="Size.Small" Class="mx-1" /></MudTooltip>
                                    }
                                    else
                                    {
                                        <MudButton Size="Size.Small" Color="Color.Info" Variant="Variant.Text" StartIcon="@Icons.Material.Filled.ReceiptLong" OnClick="@(() => CreateReceiptForExpense(context.Item))">Phiếu chi</MudButton>
                                    }
                                }
                                @if (_canUpdateExpense)
                                {
                                    <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small" OnClick="@(() => OpenEditExpense(context.Item.Id))" />
                                }
                            </CellTemplate>
                        </TemplateColumn>
                    </Columns>
                    <PagerContent><MudDataGridPager T="Expense" /></PagerContent>
                </MudDataGrid>
            </MudHidden>
            <MudHidden Breakpoint="Breakpoint.SmAndDown" Invert="true">
                @if (_expenses.Count == 0)
                {
                    <MudText Typo="Typo.body2" Class="mud-text-secondary py-4" Align="Align.Center">Chưa có khoản chi.</MudText>
                }
                else
                {
                    @foreach (var e in _expenses)
                    {
                        <MudPaper Class="mobile-card pa-3" Elevation="0">
                            <div class="d-flex justify-space-between align-center" style="gap:8px">
                                <div style="min-width:0">
                                    <MudText Typo="Typo.subtitle2" Style="font-weight:600">@Labels.Vi(e.Category)</MudText>
                                    <MudText Typo="Typo.caption" Class="mud-text-secondary">@e.Code • @e.ExpenseDate.ToString("dd/MM/yyyy")</MudText>
                                    @if (!string.IsNullOrWhiteSpace(e.Description))
                                    {
                                        <MudText Typo="Typo.caption" Class="mud-text-secondary d-block">@e.Description</MudText>
                                    }
                                </div>
                                <MudText Typo="Typo.subtitle2" Style="font-weight:600">@($"{e.Amount:N0} đ")</MudText>
                            </div>
                            <div class="d-flex flex-wrap justify-end mt-1" style="gap:4px">
                                @if (_canCreateReceipt)
                                {
                                    @if (_receiptExpenseIds.Contains(e.Id))
                                    {
                                        <MudTooltip Text="Đã có phiếu chi"><MudIcon Icon="@Icons.Material.Filled.ReceiptLong" Color="Color.Success" Size="Size.Small" Class="mx-1" /></MudTooltip>
                                    }
                                    else
                                    {
                                        <MudButton Size="Size.Small" Color="Color.Info" Variant="Variant.Text" StartIcon="@Icons.Material.Filled.ReceiptLong" OnClick="@(() => CreateReceiptForExpense(e))">Phiếu chi</MudButton>
                                    }
                                }
                                @if (_canUpdateExpense)
                                {
                                    <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small" OnClick="@(() => OpenEditExpense(e.Id))" />
                                }
                            </div>
                        </MudPaper>
                    }
                }
            </MudHidden>
        </MudTabPanel>

        @if (_canReadReceipt)
        {
            <MudTabPanel Text="@($"Phiếu thu/chi ({_receipts.Count})")">
                <MudTextField @bind-Value="_receiptSearch" Placeholder="Tìm theo mã phiếu / ứng viên / diễn giải..." Adornment="Adornment.Start"
                              AdornmentIcon="@Icons.Material.Filled.Search" Immediate="true" Clearable="true"
                              Variant="Variant.Outlined" Margin="Margin.Dense" Class="mb-3" />

                @* ===== Bảng 1 — PHIẾU THU: gom MỖI ỨNG VIÊN 1 HÀNG, bấm ▸ để xem/in từng phiếu ===== *@
                <div class="d-flex align-center mb-2" style="gap:8px">
                    <MudIcon Icon="@Icons.Material.Filled.ReceiptLong" Color="Color.Success" Size="Size.Small" />
                    <MudText Typo="Typo.subtitle1"><b>Phiếu thu (@IncomeReceiptGroups.Count ứng viên)</b></MudText>
                    <MudText Typo="Typo.caption" Class="mud-text-secondary">— bấm ▸ để xem và in từng phiếu</MudText>
                </div>
                @if (IncomeReceiptGroups.Count == 0)
                {
                    <MudText Typo="Typo.body2" Class="mud-text-secondary py-3" Align="Align.Center">
                        @(string.IsNullOrWhiteSpace(_receiptSearch) ? "Chưa có phiếu thu." : $"Không tìm thấy phiếu thu nào khớp “{_receiptSearch}”.")
                    </MudText>
                }
                else
                {
                    <MudDataGrid T="ReceiptGroupRow" Items="IncomeReceiptGroups" Hover="true" Dense="true" Striped="true">
                        <Columns>
                            <HierarchyColumn T="ReceiptGroupRow" />
                            <PropertyColumn Property="x => x.PartyName" Title="Ứng viên" />
                            <TemplateColumn Title="Số phiếu">
                                <CellTemplate>
                                    <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="Color.Success">@context.Item.Count phiếu</MudChip>
                                </CellTemplate>
                            </TemplateColumn>
                            <TemplateColumn Title="Tổng đã thu">
