                        </ChildRowContent>
                        <PagerContent><MudDataGridPager T="ReceiptGroupRow" /></PagerContent>
                    </MudDataGrid>
                }

                @* ===== Bảng 2 — PHIẾU CHI: giữ nguyên mỗi phiếu 1 hàng ===== *@
                <div class="d-flex align-center mt-6 mb-2" style="gap:8px">
                    <MudIcon Icon="@Icons.Material.Filled.ReceiptLong" Color="Color.Error" Size="Size.Small" />
                    <MudText Typo="Typo.subtitle1"><b>Phiếu chi (@ExpenseReceipts.Count)</b></MudText>
                </div>
                @if (ExpenseReceipts.Count == 0)
                {
                    <MudText Typo="Typo.body2" Class="mud-text-secondary py-3" Align="Align.Center">
                        @(string.IsNullOrWhiteSpace(_receiptSearch) ? "Chưa có phiếu chi." : $"Không tìm thấy phiếu chi nào khớp “{_receiptSearch}”.")
                    </MudText>
