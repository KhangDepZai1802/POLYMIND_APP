@page "/job-orders"
@attribute [Authorize(Policy = "job_orders:read")]
@inject IDbContextFactory<ApplicationDbContext> DbFactory
@inject NavigationManager Nav
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject IAuthorizationService AuthorizationService
@inject AuthenticationStateProvider AuthStateProvider

<PageTitle>Đơn hàng — POLYMIND</PageTitle>

<div class="d-flex justify-space-between align-center mb-4">
    <div>
        <MudText Typo="Typo.h5"><b>Đơn hàng tuyển dụng</b></MudText>
        <MudText Typo="Typo.body2" Class="mud-text-secondary">@_rows.Count đơn hàng</MudText>
    </div>
    <AuthorizeView Policy="job_orders:create">
        <Authorized>
            <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" OnClick="OpenCreate">
                Thêm đơn hàng
            </MudButton>
        </Authorized>
    </AuthorizeView>
</div>

<MudGrid>
    @foreach (var j in _rows)
    {
        <MudItem xs="12" sm="6" md="4">
            <MudCard Elevation="1" Style="height:100%;cursor:pointer" @onclick="@(() => Nav.NavigateTo($"/job-orders/{j.Id}"))">
                <MudCardContent>
                    <div class="d-flex justify-space-between align-center mb-2">
                        <MudChip T="string" Size="Size.Small" Color="Color.Info">@j.Country</MudChip>
                        <MudChip T="string" Size="Size.Small" Color="Color.Primary" Variant="Variant.Outlined">@Labels.Vi(j.Status)</MudChip>
                    </div>
                    <MudText Typo="Typo.h6"><b>@(string.IsNullOrWhiteSpace(j.CompanyName) ? "(Chưa có công ty)" : j.CompanyName)</b></MudText>
                    <MudText Typo="Typo.body2" Class="mud-text-secondary mb-2">@j.Field • @j.UnionName</MudText>
                    <MudDivider Class="my-2" />
                    <div class="d-flex justify-space-between">
                        <MudText Typo="Typo.caption">Số lượng: <b>@j.Quantity</b></MudText>
                        <MudText Typo="Typo.caption">@j.Code</MudText>
                    </div>
                    <MudText Typo="Typo.caption" Class="mud-text-secondary">Lương: @j.SalaryDescription</MudText>
                </MudCardContent>
            </MudCard>
        </MudItem>
    }
</MudGrid>

@code {
    private List<JobOrder> _rows = new();

    protected override async Task OnInitializedAsync() => await Load();

    private async Task Load()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        _rows = await db.JobOrders.OrderByDescending(j => j.CreatedAt).ToListAsync();
    }

    private async Task OpenCreate()
    {
        if (!await HasPermission("job_orders:create"))
        {
            Snackbar.Add("Bạn không có quyền tạo đơn hàng.", Severity.Warning);
            return;
        }

        var dialog = await DialogService.ShowAsync<JobOrderDialog>("Thêm đơn hàng mới");
        var result = await dialog.Result;
        if (result is not null && !result.Canceled)
        {
            Snackbar.Add("Đã thêm đơn hàng mới", Severity.Success);
            await Load();
        }
    }

    private async Task<bool> HasPermission(string permission)
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var result = await AuthorizationService.AuthorizeAsync(authState.User, null, permission);
        return result.Succeeded;
    }
}
