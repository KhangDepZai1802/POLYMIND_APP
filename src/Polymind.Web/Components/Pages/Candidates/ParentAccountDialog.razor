@using Microsoft.AspNetCore.Identity
@using Polymind.Infrastructure.Identity
@using Polymind.Infrastructure.Persistence.Constants
@inject IDbContextFactory<ApplicationDbContext> DbFactory
@inject UserManager<ApplicationUser> UserManager
@inject AuthenticationStateProvider AuthStateProvider
@inject ISnackbar Snackbar

@* Tạo/gắn tài khoản Phụ huynh (cổng cá nhân hóa) cho chính ứng viên này. *@
<MudDialog>
    <DialogContent>
        @if (_loading)
        {
            <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
        }
        else if (_linkedEmail is not null)
        {
            <MudAlert Severity="Severity.Success" Dense="true" Class="mb-2">
                Ứng viên <b>@CandidateName</b> đã có tài khoản Phụ huynh.
            </MudAlert>
            <MudText Typo="Typo.body2"><b>Đăng nhập:</b> @_linkedEmail</MudText>
            <MudText Typo="Typo.caption" Class="mud-text-secondary">Phụ huynh chỉ xem được đúng hồ sơ của con/em mình.</MudText>
            <div class="d-flex flex-wrap mt-3" style="gap:8px">
                <MudButton Variant="Variant.Outlined" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Password"
                           Disabled="_saving" OnClick="ResetPassword">Đặt lại mật khẩu (Admin@123)</MudButton>
                <MudButton Variant="Variant.Outlined" Color="Color.Error" StartIcon="@Icons.Material.Filled.LinkOff"
                           Disabled="_saving" OnClick="Unlink">Gỡ liên kết & khóa</MudButton>
            </div>
        }
        else
        {
            <MudText Typo="Typo.body2" Class="mb-2">
                Tạo tài khoản đăng nhập cho <b>phụ huynh</b> của @CandidateName (@CandidateCode).
                Tài khoản chỉ xem được hồ sơ của chính ứng viên này.
            </MudText>
            <MudTextField @bind-Value="_email" Label="Email đăng nhập" Variant="Variant.Outlined" Margin="Margin.Dense" />
            <MudText Typo="Typo.caption" Class="mud-text-secondary">Mật khẩu mặc định: <b>Admin@123</b> (phụ huynh nên đổi sau).</MudText>
        }
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="@(() => MudDialog.Cancel())">Đóng</MudButton>
        @if (_linkedEmail is null && !_loading)
        {
            <MudButton Color="Color.Primary" Variant="Variant.Filled" Disabled="_saving" OnClick="CreateAsync">Tạo tài khoản</MudButton>
        }
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = default!;
    [Parameter] public Guid CandidateId { get; set; }
    [Parameter] public string CandidateCode { get; set; } = "";
    [Parameter] public string CandidateName { get; set; } = "";

    private bool _loading = true;
    private bool _saving;
    private string? _linkedEmail;
    private string _email = "";

    protected override async Task OnInitializedAsync()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        var parentId = await db.Candidates.Where(c => c.Id == CandidateId).Select(c => c.ParentUserId).FirstOrDefaultAsync();
        if (parentId is Guid uid)
            _linkedEmail = await db.Users.Where(u => u.Id == uid).Select(u => u.Email).FirstOrDefaultAsync();
        _email = SuggestEmail(CandidateCode);
        _loading = false;
    }

    private static string SuggestEmail(string code)
    {
        var slug = new string((code ?? "").Where(char.IsLetterOrDigit).ToArray()).ToLowerInvariant();
        if (string.IsNullOrWhiteSpace(slug)) slug = Guid.NewGuid().ToString("N")[..8];
        return $"phuhuynh-{slug}@polymind.local";
    }

    private async Task CreateAsync()
    {
        _saving = true;
        try
        {
            var email = _email.Trim();
            if (string.IsNullOrWhiteSpace(email)) { Snackbar.Add("Nhập email đăng nhập.", Severity.Warning); return; }

            var existing = await UserManager.FindByEmailAsync(email);
            ApplicationUser user;
            if (existing is not null)
            {
                user = existing;
            }
            else
            {
                user = new ApplicationUser
                {
                    UserName = email,
                    Email = email,
                    EmailConfirmed = true,
                    FullName = $"Phụ huynh — {CandidateName}",
                    IsActive = true,
                };
                var create = await UserManager.CreateAsync(user, DbSeeder.DefaultAdminPassword);
                if (!create.Succeeded)
                {
                    Snackbar.Add(string.Join("; ", create.Errors.Select(e => e.Description)), Severity.Error);
                    return;
                }
            }
            if (!await UserManager.IsInRoleAsync(user, RoleNames.Parent))
                await UserManager.AddToRoleAsync(user, RoleNames.Parent);

            await using var db = await DbFactory.CreateDbContextAsync();
            var actorId = await AuthStateProvider.GetRequiredUserIdAsync(db);
            var candidate = await db.Candidates.FirstOrDefaultAsync(c => c.Id == CandidateId);
            if (candidate is null) { Snackbar.Add("Không tìm thấy ứng viên.", Severity.Warning); return; }
            candidate.ParentUserId = user.Id;
            candidate.UpdatedAt = DateTimeOffset.UtcNow;
            db.AddAudit(actorId, "link_parent", "candidates", candidate.Id, null, new { candidate.ParentUserId, email });
            await db.SaveChangesAsync();

            Snackbar.Add($"Đã tạo tài khoản Phụ huynh: {email}", Severity.Success);
            MudDialog.Close(DialogResult.Ok(true));
        }
        finally { _saving = false; }
    }

    private async Task ResetPassword()
    {
        _saving = true;
        try
        {
            if (_linkedEmail is null) return;
            var user = await UserManager.FindByEmailAsync(_linkedEmail);
            if (user is null) return;
            var token = await UserManager.GeneratePasswordResetTokenAsync(user);
            var reset = await UserManager.ResetPasswordAsync(user, token, DbSeeder.DefaultAdminPassword);
            if (reset.Succeeded) Snackbar.Add("Đã đặt lại mật khẩu về Admin@123.", Severity.Success);
            else Snackbar.Add(string.Join("; ", reset.Errors.Select(e => e.Description)), Severity.Error);
        }
        finally { _saving = false; }
    }

    private async Task Unlink()
    {
        _saving = true;
        try
        {
            await using var db = await DbFactory.CreateDbContextAsync();
            var actorId = await AuthStateProvider.GetRequiredUserIdAsync(db);
            var candidate = await db.Candidates.FirstOrDefaultAsync(c => c.Id == CandidateId);
            if (candidate?.ParentUserId is Guid uid)
            {
                var user = await UserManager.FindByIdAsync(uid.ToString());
                if (user is not null)
                {
                    user.IsActive = false;
                    var lockResult = await UserManager.UpdateSecurityStampAsync(user);
                    if (!lockResult.Succeeded)
                    {
                        Snackbar.Add(string.Join("; ", lockResult.Errors.Select(e => e.Description)), Severity.Error);
                        return;
                    }
                }
                candidate.ParentUserId = null;
                candidate.UpdatedAt = DateTimeOffset.UtcNow;
                db.AddAudit(actorId, "unlink_parent", "candidates", candidate.Id, new { ParentUserId = uid }, null);
                await db.SaveChangesAsync();
            }
            Snackbar.Add("Đã gỡ liên kết tài khoản Phụ huynh.", Severity.Success);
            MudDialog.Close(DialogResult.Ok(true));
        }
        finally { _saving = false; }
    }
}
