@page "/candidates/{Id:guid}"
@attribute [Authorize(Policy = "candidates:read")]
@inject IDbContextFactory<ApplicationDbContext> DbFactory
@inject NavigationManager Nav
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject IAuthorizationService AuthorizationService
@inject AuthenticationStateProvider AuthStateProvider
@inject IDocumentStorage DocumentStorage
@inject AgentScope AgentScope

<PageTitle>Chi tiết Ứng viên — POLYMIND</PageTitle>

@if (_accessDenied)
{
    <MudButton StartIcon="@Icons.Material.Filled.ArrowBack" Class="mb-3" OnClick="@(() => Nav.NavigateTo("/candidates"))">Quay lại</MudButton>
    <MudAlert Severity="Severity.Error">Bạn không có quyền xem ứng viên này (chỉ xem được ứng viên do mình giới thiệu).</MudAlert>
}
else if (_candidate is null)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
}
else
{
    <div class="d-flex justify-space-between align-center mb-3">
        <MudButton StartIcon="@Icons.Material.Filled.ArrowBack" OnClick="@(() => Nav.NavigateTo("/candidates"))">Quay lại</MudButton>
        @if (_canUpdateCandidate)
        {
            <MudButton Variant="Variant.Outlined" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Edit" OnClick="OpenEdit">Sửa thông tin</MudButton>
        }
    </div>

    <MudGrid>
        <MudItem xs="12" md="5">
            <MudPaper Class="pa-4 mb-4" Elevation="1">
                <div class="d-flex align-center mb-3">
                    <MudAvatar Color="Color.Primary" Size="Size.Large" Class="mr-3">@_candidate.FullName[..1]</MudAvatar>
                    <div>
                        <MudText Typo="Typo.h6"><b>@_candidate.FullName</b></MudText>
                        <MudText Typo="Typo.caption" Class="mud-text-secondary">@_candidate.Code</MudText>
                    </div>
                </div>
                <MudDivider Class="mb-3" />

                <MudText Typo="Typo.subtitle2" Class="mb-2"><b>Thông tin cá nhân</b></MudText>
                <MudGrid>
                    @Field("Số điện thoại", _candidate.Phone)
                    @Field("Giới tính", _candidate.Gender is null ? null : Labels.Vi(_candidate.Gender.Value))
                    @Field("Ngày sinh", _candidate.Dob?.ToString("dd/MM/yyyy"))
                    @Field("Hôn nhân", _candidate.MaritalStatus is null ? null : Labels.Vi(_candidate.MaritalStatus.Value))
                    @Field("Tỉnh/Thành", _candidate.Province)
                    @Field("Đơn hàng", _country)
                </MudGrid>
                @if (!string.IsNullOrWhiteSpace(_candidate.Address))
                {
                    <MudText Typo="Typo.body2" Class="mt-2"><b>Địa chỉ:</b> @_candidate.Address</MudText>
                }

                <MudDivider Class="my-3" />
                <MudText Typo="Typo.subtitle2" Class="mb-2"><b>Giấy tờ</b></MudText>
                <MudGrid>
                    @Field("Số CCCD", _candidate.CccdNumber)
                    @Field("Ngày cấp", _candidate.CccdIssueDate?.ToString("dd/MM/yyyy"))
                    @Field("Nơi cấp", _candidate.CccdIssuePlace)
                    @Field("Số hộ chiếu", _candidate.PassportNumber)
                    @Field("HC hết hạn", _candidate.PassportExpiry?.ToString("dd/MM/yyyy"))
                </MudGrid>

                @if (HasEmergencyInfo)
                {
                    <MudDivider Class="my-3" />
                    <MudText Typo="Typo.subtitle2" Class="mb-2"><b>Liên hệ khẩn cấp</b></MudText>
                    <MudGrid>
                        @Field("Người liên hệ", _candidate.EmergencyContactName)
                        @Field("SĐT", _candidate.EmergencyContactPhone)
                        @Field("Quan hệ", _candidate.EmergencyContactRelation)
                    </MudGrid>
                }

                @if (HasBankInfo)
                {
                    <MudDivider Class="my-3" />
                    <MudText Typo="Typo.subtitle2" Class="mb-2"><b>Ngân hàng</b></MudText>
                    <MudGrid>
                        @Field("Số TK", _candidate.BankAccountNumber)
                        @Field("Ngân hàng", _candidate.BankName)
                        @Field("Chủ TK", _candidate.BankAccountName)
                    </MudGrid>
                }
            </MudPaper>

            @if (_cjo is not null && _cjo.CurrentStep < WorkflowStep.Completed && _canUpdateCandidate)
            {
                <MudPaper Class="pa-4 mb-4" Elevation="1">
                    <MudText Typo="Typo.subtitle1" Class="mb-1"><b>Bước hiện tại</b></MudText>
                    <MudChip T="string" Color="Color.Primary" Class="mb-3">@Labels.Vi(_cjo.CurrentStep)</MudChip>
                    <MudButton Variant="Variant.Filled" Color="Color.Success" FullWidth="true"
                               StartIcon="@Icons.Material.Filled.ArrowForward" OnClick="AdvanceStep" Disabled="_busy">
                        Hoàn thành & chuyển bước tiếp theo
                    </MudButton>
                </MudPaper>
            }
            else if (_cjo is not null)
            {
                <MudAlert Severity="Severity.Success" Class="mb-4">Ứng viên đã hoàn tất toàn bộ quy trình 🎉</MudAlert>
            }

            @if (_cjo is null && _canUpdateCandidate)
            {
                <MudPaper Class="pa-4" Elevation="1">
                    <MudText Typo="Typo.subtitle1" Class="mb-1"><b>Gắn vào đơn hàng</b></MudText>
                    <MudText Typo="Typo.body2" Class="mb-3 mud-text-secondary">Chọn đơn hàng để bắt đầu quy trình 17 bước cho ứng viên.</MudText>
                    @if (_jobOrders.Count == 0)
                    {
                        <MudAlert Severity="Severity.Info" Dense="true">Chưa có đơn hàng nào để gắn.</MudAlert>
                    }
                    else
                    {
                        <MudSelect T="Guid?" @bind-Value="_selectedJobOrderId" Label="Đơn hàng" Variant="Variant.Outlined" Margin="Margin.Dense" Class="mb-2">
                            @foreach (var j in _jobOrders)
                            {
                                <MudSelectItem T="Guid?" Value="@j.Id">@j.Code — @j.Country (@j.CompanyName)</MudSelectItem>
                            }
                        </MudSelect>
                        <MudTextField @bind-Value="_assignNotes" Label="Ghi chú" Variant="Variant.Outlined" Margin="Margin.Dense" Lines="2" Class="mb-2" />
                        <MudButton Variant="Variant.Filled" Color="Color.Success" FullWidth="true"
                                   StartIcon="@Icons.Material.Filled.Link" OnClick="AssignJobOrder" Disabled="_busy || _selectedJobOrderId is null">
                            Gắn vào đơn hàng
                        </MudButton>
                    }
                </MudPaper>
            }

            @if (_canReadPayments)
            {
                <MudPaper Class="pa-4 mt-4" Elevation="1">
                    <MudText Typo="Typo.subtitle1" Class="mb-3"><b>Công nợ ứng viên</b></MudText>
                    <MudGrid Class="mb-2">
                        <MudItem xs="4">
                            <MudText Typo="Typo.caption" Class="mud-text-secondary">Phải thu</MudText>
                            <MudText Typo="Typo.body1"><b>@($"{_paymentTotal:N0} đ")</b></MudText>
                        </MudItem>
                        <MudItem xs="4">
                            <MudText Typo="Typo.caption" Class="mud-text-secondary">Đã thu</MudText>
                            <MudText Typo="Typo.body1" Color="Color.Success"><b>@($"{_paymentPaid:N0} đ")</b></MudText>
                        </MudItem>
                        <MudItem xs="4">
                            <MudText Typo="Typo.caption" Class="mud-text-secondary">Còn nợ</MudText>
                            <MudText Typo="Typo.body1" Color="@(_paymentOutstanding > 0 ? Color.Warning : Color.Success)"><b>@($"{_paymentOutstanding:N0} đ")</b></MudText>
                        </MudItem>
                    </MudGrid>
                    @if (_overduePaymentCount > 0)
                    {
                        <MudAlert Severity="Severity.Warning" Dense="true" Class="mb-2">
                            Có @_overduePaymentCount khoản quá hạn/chưa thu đủ.
                        </MudAlert>
                    }
                    @if (_payments.Count == 0)
                    {
                        <MudAlert Severity="Severity.Info" Dense="true">Chưa có khoản thu nào cho ứng viên này.</MudAlert>
                    }
                    else
                    {
                        <div class="table-scroll-x">
                            <MudSimpleTable Dense="true" Hover="true" Striped="true">
                                <thead>
                                    <tr>
                                        <th>Mã</th>
                                        <th>Loại</th>
                                        <th style="text-align:right">Số tiền</th>
                                        <th>Trạng thái</th>
                                        <th>Hạn thu</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var payment in _payments)
                                    {
                                        <tr>
                                            <td>@payment.Code</td>
                                            <td>@Labels.Vi(payment.Type)</td>
                                            <td style="text-align:right">@($"{payment.Amount:N0} đ")</td>
                                            <td><MudChip T="string" Size="Size.Small" Color="Labels.ColorOf(payment.Status)">@Labels.Vi(payment.Status)</MudChip></td>
                                            <td>@(payment.DueDate?.ToString("dd/MM/yyyy") ?? "—")</td>
                                        </tr>
                                    }
                                </tbody>
                            </MudSimpleTable>
                        </div>
                    }
                </MudPaper>
            }
        </MudItem>

        <MudItem xs="12" md="7">
            <MudPaper Class="pa-4" Elevation="1">
                <MudText Typo="Typo.subtitle1" Class="mb-3"><b>Quy trình 17 bước</b></MudText>
                @if (_cjo is null)
                {
                    <MudAlert Severity="Severity.Info">Ứng viên chưa được gắn vào đơn hàng nào.</MudAlert>
                }
                else
                {
                    <MudTimeline TimelinePosition="TimelinePosition.Start" Class="workflow-timeline">
                        @foreach (var step in Enum.GetValues<WorkflowStep>())
                        {
                            var state = StateOf(step);
                            <MudTimelineItem Color="@state.Color" Size="Size.Small"
                                             Icon="@(state.Done ? Icons.Material.Filled.Check : state.Current ? Icons.Material.Filled.RadioButtonChecked : Icons.Material.Filled.RadioButtonUnchecked)">
                                <MudText Typo="Typo.body2" Style="@(state.Pending ? "color:#94a3b8" : "")">
                                    <b>@((int)step).</b> @Labels.Vi(step)
                                </MudText>
                                @if (state.Current)
                                {
                                    <MudChip T="string" Size="Size.Small" Color="Color.Primary" Class="mt-1">Đang xử lý</MudChip>
                                }
                            </MudTimelineItem>
                        }
                    </MudTimeline>
                }
            </MudPaper>

            <MudPaper Class="pa-4 mt-4" Elevation="1">
                <div class="d-flex justify-space-between align-center mb-3">
                    <MudText Typo="Typo.subtitle1"><b>Hồ sơ ứng viên (@_documents.Count)</b></MudText>
                    <MudChip T="string" Size="Size.Small" Color="Color.Info">MinIO</MudChip>
                </div>

                @if (_canUpdateCandidate)
                {
                    <MudGrid Class="mb-3">
                        <MudItem xs="12" sm="4">
                            <MudSelect T="DocumentType" @bind-Value="_uploadDocType" Label="Loại hồ sơ" Variant="Variant.Outlined" Margin="Margin.Dense">
                                @foreach (var type in Enum.GetValues<DocumentType>())
                                {
                                    <MudSelectItem Value="@type">@Labels.Vi(type)</MudSelectItem>
                                }
                            </MudSelect>
                        </MudItem>
                        <MudItem xs="12" sm="5">
                            <MudText Typo="Typo.caption" Class="mud-text-secondary">File hồ sơ</MudText>
                            <InputFile OnChange="OnDocumentSelected" />
                            @if (_selectedDocumentFile is not null)
                            {
                                <MudText Typo="Typo.caption" Class="mud-text-secondary">
                                    @_selectedDocumentFile.Name (@FormatFileSize(_selectedDocumentFile.Size))
                                </MudText>
                            }
                        </MudItem>
                        <MudItem xs="12" sm="3">
                            <MudTextField @bind-Value="_documentNotes" Label="Ghi chú" Variant="Variant.Outlined" Margin="Margin.Dense" />
                        </MudItem>
                        <MudItem xs="12">
                            <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.UploadFile"
                                       Disabled="_uploading || _selectedDocumentFile is null" OnClick="UploadDocument">
                                Upload hồ sơ
                            </MudButton>
                            <MudText Typo="Typo.caption" Class="mud-text-secondary ml-2">
                                Hỗ trợ PDF, ảnh, Word, Excel. Tối đa @FormatFileSize(DocumentStorage.MaxUploadBytes).
                            </MudText>
                        </MudItem>
                    </MudGrid>
                }

                @if (_documents.Count == 0)
                {
                    <MudAlert Severity="Severity.Info" Dense="true">Chưa có hồ sơ nào được upload.</MudAlert>
                }
                else
                {
                    <div class="table-scroll-x">
                    <MudSimpleTable Dense="true" Hover="true" Striped="true">
                        <thead>
                            <tr>
                                <th>Loại</th>
                                <th>File hiện hành</th>
                                <th>Phiên bản</th>
                                <th>Dung lượng</th>
                                <th>Upload lúc</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var document in _documents)
                            {
                                <tr>
                                    <td>@Labels.Vi(document.DocType)</td>
                                    <td>
                                        <div>@document.FileName</div>
                                        @if (!string.IsNullOrWhiteSpace(document.Notes))
                                        {
                                            <MudText Typo="Typo.caption" Class="mud-text-secondary">@document.Notes</MudText>
                                        }
                                    </td>
                                    <td>v@document.VersionNumber</td>
                                    <td>@FormatFileSize(document.FileSize)</td>
                                    <td>@document.UploadedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td>
                                    <td style="text-align:right; white-space:nowrap">
                                        <MudButton Size="Size.Small" Variant="Variant.Text" Color="Color.Primary"
                                                   StartIcon="@Icons.Material.Filled.Download"
                                                   OnClick="@(() => DownloadDocument(document.VersionId))">
                                            Tải
                                        </MudButton>
                                        @if (_versionsByDoc.TryGetValue(document.DocumentId, out var vers) && vers.Count > 1)
                                        {
                                            <MudButton Size="Size.Small" Variant="Variant.Text"
                                                       StartIcon="@Icons.Material.Filled.History"
                                                       OnClick="@(() => ToggleHistory(document.DocumentId))">
                                                Lịch sử (@vers.Count)
                                            </MudButton>
                                        }
                                    </td>
                                </tr>
                                @if (_expandedDocId == document.DocumentId && _versionsByDoc.TryGetValue(document.DocumentId, out var history))
                                {
                                    <tr>
                                        <td colspan="6" style="background-color: var(--mud-palette-background-grey)">
                                            <MudText Typo="Typo.caption" Class="mud-text-secondary mb-1"><b>Các phiên bản</b></MudText>
                                            @foreach (var v in history)
                                            {
                                                <div class="d-flex align-center py-1" style="gap:8px">
                                                    <MudChip T="string" Size="Size.Small" Color="@(v.IsCurrent ? Color.Success : Color.Default)">v@v.VersionNumber</MudChip>
                                                    <span class="flex-grow-1">@v.FileName <span class="mud-text-secondary">(@FormatFileSize(v.FileSize) — @v.UploadedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm"))</span></span>
                                                    <MudIconButton Icon="@Icons.Material.Filled.Download" Size="Size.Small" OnClick="@(() => DownloadDocument(v.VersionId))" />
                                                    @if (_canUpdateCandidate && !v.IsCurrent)
                                                    {
                                                        <MudButton Size="Size.Small" Variant="Variant.Text" Color="Color.Primary"
                                                                   StartIcon="@Icons.Material.Filled.RestartAlt"
                                                                   OnClick="@(() => RestoreVersion(document.DocumentId, v.VersionId))">
                                                            Đặt hiện hành
                                                        </MudButton>
                                                    }
                                                    else if (v.IsCurrent)
                                                    {
                                                        <MudText Typo="Typo.caption" Color="Color.Success">Hiện hành</MudText>
                                                    }
                                                </div>
                                            }
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </MudSimpleTable>
                    </div>
                }
            </MudPaper>
        </MudItem>
    </MudGrid>
}

@code {
    [Parameter] public Guid Id { get; set; }

    private Candidate? _candidate;
    private CandidateJobOrder? _cjo;
    private string? _country;
    private bool _busy;
    private bool _accessDenied;
    private bool _canUpdateCandidate;
    private bool _canReadPayments;

    private List<JobOrder> _jobOrders = new();
    private List<CandidatePaymentRow> _payments = new();
    private List<CandidateDocumentRow> _documents = new();
    private Guid? _selectedJobOrderId;
    private string _assignNotes = "";
    private decimal _paymentTotal;
    private decimal _paymentPaid;
    private decimal _paymentOutstanding;
    private int _overduePaymentCount;
    private DocumentType _uploadDocType = DocumentType.Cccd;
    private IBrowserFile? _selectedDocumentFile;
    private string _documentNotes = "";
    private bool _uploading;

    private record CandidatePaymentRow(Guid Id, string Code, PaymentType Type, decimal Amount, PaymentStatus Status, DateOnly? DueDate, DateOnly? PaidDate);
    private record CandidateDocumentRow(
        Guid DocumentId,
        Guid VersionId,
        DocumentType DocType,
        string FileName,
        long FileSize,
        string? MimeType,
        int VersionNumber,
        DateTimeOffset UploadedAt,
        string? Notes);
    private record DocumentVersionRow(Guid VersionId, int VersionNumber, string FileName, long FileSize, DateTimeOffset UploadedAt, bool IsCurrent);

    private Dictionary<Guid, List<DocumentVersionRow>> _versionsByDoc = new();
    private Guid? _expandedDocId;

    private bool HasEmergencyInfo => !string.IsNullOrWhiteSpace(_candidate?.EmergencyContactName)
        || !string.IsNullOrWhiteSpace(_candidate?.EmergencyContactPhone);
    private bool HasBankInfo => !string.IsNullOrWhiteSpace(_candidate?.BankAccountNumber)
        || !string.IsNullOrWhiteSpace(_candidate?.BankName);

    protected override async Task OnInitializedAsync()
    {
        _canUpdateCandidate = await HasPermission("candidates:update");
        _canReadPayments = await HasPermission("payments:read");
        await Load();
    }

    private async Task Load()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        _candidate = await db.Candidates.FirstOrDefaultAsync(c => c.Id == Id);
        if (_candidate is null) return;

        // Đại lý chỉ được xem ứng viên do mình giới thiệu (spec §2.8).
        var scope = await AgentScope.GetAsync();
        if (scope.IsAgentOnly && _candidate.AgentId != scope.AgentId)
        {
            _accessDenied = true;
            _candidate = null;
            return;
        }
        _cjo = await db.CandidateJobOrders.Where(j => j.CandidateId == Id)
            .OrderByDescending(j => j.CreatedAt).FirstOrDefaultAsync();
        if (_cjo is not null)
        {
            _country = await db.JobOrders.Where(j => j.Id == _cjo.JobOrderId).Select(j => j.Country).FirstOrDefaultAsync();
        }
        else
        {
            _jobOrders = await db.JobOrders
                .Where(j => j.Status != JobOrderStatus.Cancelled)
                .OrderByDescending(j => j.CreatedAt).ToListAsync();
        }

        if (_canReadPayments)
        {
            var payments = await db.Payments
                .Where(p => p.CandidateId == Id)
                .OrderByDescending(p => p.CreatedAt)
                .ToListAsync();

            _payments = payments.Select(p => new CandidatePaymentRow(
                p.Id,
                p.Code,
                p.PaymentType,
                p.Amount,
                p.Status,
                p.DueDate,
                p.PaidDate)).ToList();

            _paymentTotal = payments.Where(p => p.Status != PaymentStatus.Refunded).Sum(p => p.Amount);
            _paymentPaid = payments.Where(p => p.Status == PaymentStatus.Paid).Sum(p => p.Amount);
            _paymentOutstanding = Math.Max(0, _paymentTotal - _paymentPaid);
            var today = DateOnly.FromDateTime(DateTime.UtcNow);
            _overduePaymentCount = payments.Count(p =>
                p.Status is PaymentStatus.Pending or PaymentStatus.Partial or PaymentStatus.Overdue
                && p.DueDate is not null
                && p.DueDate.Value < today);
        }

        var documents = await db.CandidateDocuments
            .Where(d => d.CandidateId == Id)
            .OrderBy(d => d.DocType)
            .ToListAsync();

        if (documents.Count == 0)
        {
            _documents = new();
            return;
        }

        var documentIds = documents.Select(d => d.Id).ToList();
        var versions = await db.DocumentVersions
            .Where(v => documentIds.Contains(v.DocumentId))
            .OrderByDescending(v => v.VersionNumber)
            .ToListAsync();

        _documents = documents
            .Select(d =>
            {
                var current = d.CurrentVersionId is null
                    ? versions.FirstOrDefault(v => v.DocumentId == d.Id)
                    : versions.FirstOrDefault(v => v.Id == d.CurrentVersionId.Value)
                        ?? versions.FirstOrDefault(v => v.DocumentId == d.Id);

                return current is null
                    ? null
                    : new CandidateDocumentRow(
                        d.Id,
                        current.Id,
                        d.DocType,
                        current.FileName,
                        current.FileSize,
                        current.MimeType,
                        current.VersionNumber,
                        current.CreatedAt,
                        current.Notes);
            })
            .Where(row => row is not null)
            .Cast<CandidateDocumentRow>()
            .ToList();

        _versionsByDoc = documents.ToDictionary(
            d => d.Id,
            d => versions.Where(v => v.DocumentId == d.Id)
                .OrderByDescending(v => v.VersionNumber)
                .Select(v => new DocumentVersionRow(v.Id, v.VersionNumber, v.FileName, v.FileSize, v.CreatedAt,
                    d.CurrentVersionId == v.Id))
                .ToList());
    }

    private async Task OpenEdit()
    {
        var parameters = new DialogParameters<CandidateDialog> { { x => x.CandidateId, Id } };
        var dialog = await DialogService.ShowAsync<CandidateDialog>("Sửa thông tin ứng viên", parameters);
        var result = await dialog.Result;
        if (result is not null && !result.Canceled)
        {
            Snackbar.Add("Đã cập nhật ứng viên", Severity.Success);
            await Load();
        }
    }

    private async Task AssignJobOrder()
    {
        if (_selectedJobOrderId is null) return;
        if (!await HasPermission("candidates:update"))
        {
            Snackbar.Add("Bạn không có quyền gắn ứng viên vào đơn hàng.", Severity.Warning);
            return;
        }

        _busy = true;
        try
        {
            await using var db = await DbFactory.CreateDbContextAsync();
            var actorId = await AuthStateProvider.GetRequiredUserIdAsync(db);
            var assignment = new CandidateJobOrder
            {
                CandidateId = Id,
                JobOrderId = _selectedJobOrderId.Value,
                CurrentStep = WorkflowStep.Lead,
                Status = CandidateJobOrderStatus.Active,
                AssignedTo = actorId,
                Notes = string.IsNullOrWhiteSpace(_assignNotes) ? null : _assignNotes,
            };
            db.CandidateJobOrders.Add(assignment);
            db.AddAudit(actorId, "assign", "candidate_job_orders", assignment.Id, null, new
            {
                assignment.CandidateId,
                assignment.JobOrderId,
                assignment.CurrentStep,
                assignment.Status,
                assignment.AssignedTo,
            });
            await db.SaveChangesAsync();

            Snackbar.Add("Đã gắn ứng viên vào đơn hàng", Severity.Success);
            _selectedJobOrderId = null;
            _assignNotes = "";
            await Load();
        }
        finally
        {
            _busy = false;
        }
    }

    private (Color Color, bool Done, bool Current, bool Pending) StateOf(WorkflowStep step)
    {
        if (_cjo is null) return (Color.Default, false, false, true);
        if (step < _cjo.CurrentStep) return (Color.Success, true, false, false);
        if (step == _cjo.CurrentStep) return (Color.Primary, false, true, false);
        return (Color.Default, false, false, true);
    }

    private async Task AdvanceStep()
    {
        if (_cjo is null || _cjo.CurrentStep >= WorkflowStep.Completed) return;
        if (!await HasPermission("candidates:update"))
        {
            Snackbar.Add("Bạn không có quyền cập nhật quy trình ứng viên.", Severity.Warning);
            return;
        }

        _busy = true;
        try
        {
            await using var db = await DbFactory.CreateDbContextAsync();
            var cjo = await db.CandidateJobOrders.FirstAsync(j => j.Id == _cjo.Id);
            var actorId = await AuthStateProvider.GetRequiredUserIdAsync(db);
            var completed = cjo.CurrentStep;
            var next = (WorkflowStep)((int)cjo.CurrentStep + 1);
            var oldStatus = cjo.Status;

            db.WorkflowStepRecords.Add(new WorkflowStepRecord
            {
                CandidateJobOrderId = cjo.Id,
                Step = completed,
                Status = WorkflowStepStatus.Completed,
                AssignedTo = actorId,
                CompletedAt = DateTimeOffset.UtcNow,
                CreatedBy = actorId,
            });
            cjo.CurrentStep = next;
            cjo.UpdatedAt = DateTimeOffset.UtcNow;
            if (next == WorkflowStep.Completed) cjo.Status = CandidateJobOrderStatus.Completed;

            var newCommissions = await EnsureCommissionsAsync(db, cjo, _candidate?.AgentId, actorId);
            db.AddAudit(actorId, "advance_step", "candidate_job_orders", cjo.Id, new
            {
                CurrentStep = completed,
                Status = oldStatus,
            }, new
            {
                CurrentStep = next,
                cjo.Status,
                CompletedStep = completed,
                NewCommissions = newCommissions,
            });
            await db.SaveChangesAsync();

            Snackbar.Add($"Đã chuyển sang bước: {Labels.Vi(next)}", Severity.Success);
            if (newCommissions > 0)
                Snackbar.Add($"Đã phát sinh {newCommissions} mốc hoa hồng cho đại lý.", Severity.Info);
            await Load();
        }
        finally
        {
            _busy = false;
        }
    }

    private void OnDocumentSelected(InputFileChangeEventArgs args)
    {
        _selectedDocumentFile = args.File;
    }

    private async Task UploadDocument()
    {
        if (_selectedDocumentFile is null)
        {
            Snackbar.Add("Vui lòng chọn file hồ sơ.", Severity.Warning);
            return;
        }
        if (!await HasPermission("candidates:update"))
        {
            Snackbar.Add("Bạn không có quyền upload hồ sơ ứng viên.", Severity.Warning);
            return;
        }

        _uploading = true;
        try
        {
            var uploaded = await DocumentStorage.UploadAsync(Id, _uploadDocType, _selectedDocumentFile);

            await using var db = await DbFactory.CreateDbContextAsync();
            var actorId = await AuthStateProvider.GetRequiredUserIdAsync(db);
            var document = await db.CandidateDocuments
                .FirstOrDefaultAsync(d => d.CandidateId == Id && d.DocType == _uploadDocType);

            var createdDocument = false;
            if (document is null)
            {
                document = new CandidateDocument
                {
                    CandidateId = Id,
                    DocType = _uploadDocType,
                };
                db.CandidateDocuments.Add(document);
                createdDocument = true;
            }

            var nextVersion = await db.DocumentVersions
                .Where(v => v.DocumentId == document.Id)
                .MaxAsync(v => (int?)v.VersionNumber) ?? 0;

            var version = new DocumentVersion
            {
                DocumentId = document.Id,
                VersionNumber = nextVersion + 1,
                FileUrl = uploaded.ObjectKey,
                FileName = uploaded.FileName,
                FileSize = uploaded.FileSize,
                MimeType = uploaded.ContentType,
                UploadedBy = actorId,
                Notes = string.IsNullOrWhiteSpace(_documentNotes) ? null : _documentNotes.Trim(),
            };
            db.DocumentVersions.Add(version);
            document.CurrentVersionId = version.Id;
            document.UpdatedAt = DateTimeOffset.UtcNow;
            db.AddAudit(actorId, createdDocument ? "create" : "upload_version", "candidate_documents", document.Id, null, new
            {
                document.CandidateId,
                document.DocType,
                document.CurrentVersionId,
                VersionId = version.Id,
                version.VersionNumber,
                ObjectKey = version.FileUrl,
                version.FileName,
                version.FileSize,
                version.MimeType,
            });

            await db.SaveChangesAsync();
            Snackbar.Add("Đã upload hồ sơ lên MinIO.", Severity.Success);
            _selectedDocumentFile = null;
            _documentNotes = "";
            await Load();
        }
        catch (InvalidOperationException ex)
        {
            Snackbar.Add(ex.Message, Severity.Warning);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Không upload được hồ sơ: {ex.Message}", Severity.Error);
        }
        finally
        {
            _uploading = false;
        }
    }

    private async Task DownloadDocument(Guid versionId)
    {
        try
        {
            await using var db = await DbFactory.CreateDbContextAsync();
            var version = await db.DocumentVersions.FirstOrDefaultAsync(v => v.Id == versionId);
            if (version is null)
            {
                Snackbar.Add("Không tìm thấy phiên bản hồ sơ.", Severity.Warning);
                return;
            }

            var url = await DocumentStorage.GetDownloadUrlAsync(version.FileUrl);
            Nav.NavigateTo(url, forceLoad: true);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Không tạo được link tải hồ sơ: {ex.Message}", Severity.Error);
        }
    }

    private void ToggleHistory(Guid documentId)
        => _expandedDocId = _expandedDocId == documentId ? null : documentId;

    private async Task RestoreVersion(Guid documentId, Guid versionId)
    {
        if (!await HasPermission("candidates:update"))
        {
            Snackbar.Add("Bạn không có quyền khôi phục hồ sơ.", Severity.Warning);
            return;
        }
        await using var db = await DbFactory.CreateDbContextAsync();
        var document = await db.CandidateDocuments.FirstOrDefaultAsync(d => d.Id == documentId && d.CandidateId == Id);
        if (document is null) return;
        if (document.CurrentVersionId == versionId) return;

        var actorId = await AuthStateProvider.GetRequiredUserIdAsync(db);
        var oldVersionId = document.CurrentVersionId;
        document.CurrentVersionId = versionId;
        document.UpdatedAt = DateTimeOffset.UtcNow;
        db.AddAudit(actorId, "restore_version", "candidate_documents", document.Id,
            new { CurrentVersionId = oldVersionId }, new { document.CurrentVersionId });
        await db.SaveChangesAsync();
        Snackbar.Add("Đã đặt phiên bản này làm hiện hành.", Severity.Success);
        await Load();
    }

    // Mốc hoa hồng ↔ bước workflow tương ứng (mục 8.3).
    private static readonly (CommissionMilestone Milestone, WorkflowStep Step)[] CommissionMilestones =
    {
        (CommissionMilestone.Deposit, WorkflowStep.Deposit),
        (CommissionMilestone.Selected, WorkflowStep.Selected),
        (CommissionMilestone.Departure, WorkflowStep.Departure),
    };

    /// <summary>Tự sinh hoa hồng cho các mốc đã đạt (nếu ứng viên có đại lý và có cấu hình). Idempotent.</summary>
    private static async Task<int> EnsureCommissionsAsync(ApplicationDbContext db, CandidateJobOrder cjo, Guid? agentId, Guid actorId)
    {
        if (agentId is null) return 0;
        var jo = await db.JobOrders.FirstOrDefaultAsync(j => j.Id == cjo.JobOrderId);
        if (jo is null) return 0;
        var baseAmount = jo.CostAmount ?? 0m;
        var configs = await db.AgentCommissionConfigs.Where(c => c.AgentId == agentId.Value).ToListAsync();

        var created = 0;
        foreach (var (milestone, step) in CommissionMilestones)
        {
            if ((int)cjo.CurrentStep < (int)step) continue;

            var exists = await db.AgentCommissions.AnyAsync(c =>
                c.AgentId == agentId.Value && c.CandidateId == cjo.CandidateId &&
                c.JobOrderId == cjo.JobOrderId && c.Milestone == milestone);
            if (exists) continue;

            // Ưu tiên cấu hình theo đúng đơn hàng / quốc gia, rồi tới cấu hình chung.
            var cfg = configs.Where(c => c.Milestone == milestone)
                .OrderByDescending(c => c.JobOrderId == cjo.JobOrderId)
                .ThenByDescending(c => c.Country == jo.Country)
                .FirstOrDefault();
            if (cfg is null) continue;

            var amount = cfg.Percentage.HasValue
                ? baseAmount * cfg.Percentage.Value / 100m
                : (cfg.FixedAmount ?? 0m);

            var commission = new AgentCommission
            {
                AgentId = agentId.Value,
                CandidateId = cjo.CandidateId,
                JobOrderId = cjo.JobOrderId,
                ConfigId = cfg.Id,
                Milestone = milestone,
                BaseAmount = baseAmount,
                CommissionAmount = amount,
                Status = CommissionStatus.Pending,
            };
            db.AgentCommissions.Add(commission);
            db.AddAudit(actorId, "create", "agent_commissions", commission.Id, null, new
            {
                commission.AgentId,
                commission.CandidateId,
                commission.JobOrderId,
                commission.ConfigId,
                commission.Milestone,
                commission.BaseAmount,
                commission.CommissionAmount,
                commission.Status,
            });
            created++;
        }
        return created;
    }

    private async Task<bool> HasPermission(string permission)
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var result = await AuthorizationService.AuthorizeAsync(authState.User, null, permission);
        return result.Succeeded;
    }

    private RenderFragment Field(string label, string? value) =>@<MudItem xs="6">
        <MudText Typo="Typo.caption" Class="mud-text-secondary">@label</MudText>
        <MudText Typo="Typo.body2">@(string.IsNullOrWhiteSpace(value) ? "—" : value)</MudText>
    </MudItem>;

    private static string FormatFileSize(long bytes)
    {
        if (bytes >= 1024 * 1024)
            return $"{bytes / 1024d / 1024d:N1} MB";
        if (bytes >= 1024)
            return $"{bytes / 1024d:N1} KB";
        return $"{bytes:N0} B";
    }
