@using Microsoft.AspNetCore.Identity
@using Polymind.Infrastructure.Identity
@inject UserManager<ApplicationUser> UserManager
@inject IDbContextFactory<ApplicationDbContext> DbFactory
@inject AuthenticationStateProvider AuthState
@inject ISnackbar Snackbar

@* RB-4: người dùng (đặc biệt Phụ huynh/Học sinh) tự đổi mật khẩu của chính mình.
   Dùng UserManager.ChangePasswordAsync (kiểm tra mật khẩu hiện tại, lưu hash — KHÔNG lưu plaintext). *@
<MudDialog>
    <DialogContent>
        <MudAlert Severity="Severity.Info" Dense="true" Class="mb-3">
            Đổi mật khẩu đăng nhập của bạn. Sau khi đổi, hãy dùng mật khẩu mới cho các lần đăng nhập sau.
        </MudAlert>
        <MudTextField @bind-Value="_current" Label="Mật khẩu hiện tại" Variant="Variant.Outlined" Margin="Margin.Dense" Class="mb-3"
                      AutoFocus="true" InputType="@(_show ? InputType.Text : InputType.Password)"
                      Adornment="Adornment.End"
                      AdornmentIcon="@(_show ? Icons.Material.Filled.VisibilityOff : Icons.Material.Filled.Visibility)"
                      OnAdornmentClick="@(() => _show = !_show)" />
        <MudTextField @bind-Value="_new" Label="Mật khẩu mới" Variant="Variant.Outlined" Margin="Margin.Dense" Class="mb-3"
                      InputType="@(_show ? InputType.Text : InputType.Password)" />
        <MudTextField @bind-Value="_confirm" Label="Nhập lại mật khẩu mới" Variant="Variant.Outlined" Margin="Margin.Dense"
                      InputType="@(_show ? InputType.Text : InputType.Password)" />
        @if (!string.IsNullOrEmpty(_error))
        {
            <MudText Typo="Typo.caption" Color="Color.Error" Class="mt-1">@_error</MudText>
        }
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="@(() => MudDialog.Cancel())">Hủy</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" Disabled="_saving" OnClick="SaveAsync">Đổi mật khẩu</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = default!;

    private string _current = "";
    private string _new = "";
    private string _confirm = "";
    private string? _error;
    private bool _show;
    private bool _saving;

    private async Task SaveAsync()
    {
        _error = null;
        if (string.IsNullOrWhiteSpace(_current) || string.IsNullOrWhiteSpace(_new))
        {
            _error = "Vui lòng nhập mật khẩu hiện tại và mật khẩu mới.";
            return;
        }
        if (_new != _confirm)
        {
            _error = "Mật khẩu mới nhập lại không khớp.";
            return;
        }
        if (_new == _current)
        {
            _error = "Mật khẩu mới phải khác mật khẩu hiện tại.";
            return;
        }

        _saving = true;
        try
        {
            var authState = await AuthState.GetAuthenticationStateAsync();
            var user = await UserManager.GetUserAsync(authState.User);
            if (user is null)
            {
                _error = "Không xác định được tài khoản đang đăng nhập.";
                return;
            }

            var result = await UserManager.ChangePasswordAsync(user, _current, _new);
            if (!result.Succeeded)
            {
                _error = string.Join("; ", result.Errors.Select(e => e.Description));
                return;
            }

            await using var db = await DbFactory.CreateDbContextAsync();
            // Audit: chỉ ghi nhận việc đổi mật khẩu, KHÔNG lưu giá trị mật khẩu.
            db.AddAudit(user.Id, "change_password", "users", user.Id, null, new { PasswordChanged = true });
            await db.SaveChangesAsync();

            Snackbar.Add("Đã đổi mật khẩu. Lần đăng nhập tới hãy dùng mật khẩu mới.", Severity.Success);
            MudDialog.Close(DialogResult.Ok(true));
        }
        finally
        {
            _saving = false;
        }
    }
}
