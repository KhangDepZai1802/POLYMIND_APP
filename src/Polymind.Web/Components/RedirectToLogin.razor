@inject NavigationManager Nav
@inject AuthenticationStateProvider AuthStateProvider
@inject Polymind.Web.Identity.AgentScope AgentScope

@code {
    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        if (authState.User.Identity?.IsAuthenticated == true)
        {
            // Đưa về trang mặc định theo vai trò thay vì hiện "Không có quyền":
            // Phụ huynh/Học viên → Tổng quan cá nhân; Đại lý/CTV → Bảng thi đua; còn lại mới báo access-denied.
            var scope = await AgentScope.GetAsync();
            var landing = scope.IsSelfScoped ? "/me"
                : scope.IsPartnerOnly ? "/agents"
                : "/access-denied";
            Nav.NavigateTo(landing);
            return;
        }

        var returnUrl = Uri.EscapeDataString(new Uri(Nav.Uri).PathAndQuery);
        Nav.NavigateTo($"/login?ReturnUrl={returnUrl}", forceLoad: true);
    }
}
